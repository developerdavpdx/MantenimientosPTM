<configuration>
	<!-- LOG4NET -->
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>
	<log4net>
		<!-- ── Appender existentes ── -->
		<appender name="AppenderVentasMovil" type="log4net.Appender.RollingFileAppender">
			<file value="Logs\Entregas\LogEntregas.txt" />
			<appendToFile value="true" />
			<encoding value="utf-8" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd'.log'" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date %-5level %logger - %message%newline" />
			</layout>
		</appender>
		<logger name="VentasMovil" additivity="false">
			<level value="DEBUG" />
			<appender-ref ref="AppenderVentasMovil" />
		</logger>
		<appender name="AppenderInventariosMovil" type="log4net.Appender.RollingFileAppender">
			<file value="Logs\Inventarios\LogInventarios.txt" />
			<appendToFile value="true" />
			<encoding value="utf-8" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd'.log'" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date %-5level %logger - %message%newline" />
			</layout>
		</appender>
		<logger name="InventariosMovil" additivity="false">
			<level value="DEBUG" />
			<appender-ref ref="AppenderInventariosMovil" />
		</logger>
		<!-- ── Almacen — Solicitud Compra ── -->
		<appender name="AppenderAlmacenSolicitudCompra" type="log4net.Appender.RollingFileAppender">
			<file value="Logs\Almacen\SolicitudCompra\LogSolicitudCompra.txt" />
			<appendToFile value="true" />
			<encoding value="utf-8" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd'.log'" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date %-5level %logger - %message%newline" />
			</layout>
		</appender>
		<logger name="AlmacenSolicitudCompra" additivity="false">
			<level value="DEBUG" />
			<appender-ref ref="AppenderAlmacenSolicitudCompra" />
		</logger>
		<root>
			<level value="DEBUG" />
			<appender-ref ref="RollingFileAppender" />
		</root>
	</log4net>
