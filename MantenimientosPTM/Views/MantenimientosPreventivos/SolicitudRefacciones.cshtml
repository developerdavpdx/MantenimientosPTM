@{
    ViewBag.Title = "Solicitudes de Refacciones";
}

<div class="row m-0 pt-3">
    <div class="col-12 col-xl-12 mb-4 mb-lg-0">
        <div class="card">
            <div class="card-header text-dark d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-color-logo">Solicitudes de Refacciones - Órdenes de Trabajo</h5>
                <div>
                </div>
            </div>
            <div class="card-body">
                <!-- Filtros -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Filtrar por OT:</label>
                        <select class="form-select" id="filtroOT">
                            <option value="">Todas las OT</option>
                            <option value="OT-005">OT-005</option>
                            <option value="OT-008">OT-008</option>
                            <option value="OT-012">OT-012</option>
                            <option value="OT-018">OT-018</option>
                            <option value="OT-022">OT-022</option>
                            <option value="OT-025">OT-025</option>
                            <option value="OT-028">OT-028</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Filtrar por Estatus:</label>
                        <select class="form-select" id="filtroEstatus">
                            <option value="">Todos los estatus</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Autorizado">Autorizado</option>
                            <option value="Rechazado">Rechazado</option>
                            <option value="En tránsito">En tránsito</option>
                            <option value="Entregado">Entregado</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Filtrar por Urgencia:</label>
                        <select class="form-select" id="filtroUrgencia">
                            <option value="">Todas las urgencias</option>
                            <option value="Normal">Normal</option>
                            <option value="Urgente">Urgente</option>
                            <option value="Crítico">Crítico</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <button class="btn btn-outline-secondary w-100" id="btnLimpiarFiltros">
                            <i class="fas fa-times"></i> Limpiar Filtros
                        </button>
                    </div>
                </div>

                <div class="table-responsive small">
                    <table class="table table-striped table-sm CustomTableResponsive" id="tablaSolicitudesRefacciones">
                        <thead>
                            <tr>
                                <th scope="col"># Solicitud</th>
                                <th scope="col">Orden Trabajo</th>
                                <th scope="col">Equipo</th>
                                <th scope="col">Refacción Solicitada</th>
                                <th scope="col">Cantidad</th>
                                <th scope="col">Urgencia</th>
                                <th scope="col">Fecha Solicitud</th>
                                <th scope="col">Solicitante</th>
                                <th scope="col">Estatus</th>
                                <th scope="col" width="120">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>SOL-001</td>
                                <td>OT-028</td>
                                <td>EMP-345</td>
                                <td>Rodamiento axial 6008-2RS</td>
                                <td>2</td>
                                <td><span class="badge bg-warning">Urgente</span></td>
                                <td>@DateTime.Now.AddDays(-2).ToString("dd/MM/yyyy")</td>
                                <td>Carlos Rodríguez</td>
                                <td><span class="badge bg-info">Pendiente</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary btn-editar-solicitud" data-id="1" data-bs-toggle="tooltip" title="Actualizar Estatus">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>SOL-002</td>
                                <td>OT-025</td>
                                <td>ROB-6AX</td>
                                <td>Servomotor Yaskawa SGM7G-1EAFC6S</td>
                                <td>1</td>
                                <td><span class="badge bg-danger">Crítico</span></td>
                                <td>@DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy")</td>
                                <td>Ana Gómez</td>
                                <td><span class="badge bg-success">Autorizado</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary btn-editar-solicitud" data-id="2" data-bs-toggle="tooltip" title="Actualizar Estatus">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>SOL-003</td>
                                <td>OT-018</td>
                                <td>ML-2200</td>
                                <td>Válvula proporcional Parker D1FVE50BC9</td>
                                <td>1</td>
                                <td><span class="badge bg-primary">Normal</span></td>
                                <td>@DateTime.Now.ToString("dd/MM/yyyy")</td>
                                <td>Miguel Torres</td>
                                <td><span class="badge bg-warning">En tránsito</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary btn-editar-solicitud" data-id="3" data-bs-toggle="tooltip" title="Actualizar Estatus">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>SOL-004</td>
                                <td>OT-008</td>
                                <td>MEZ-850</td>
                                <td>Sensor de temperatura PT100</td>
                                <td>3</td>
                                <td><span class="badge bg-primary">Normal</span></td>
                                <td>@DateTime.Now.AddDays(-3).ToString("dd/MM/yyyy")</td>
                                <td>Laura Sánchez</td>
                                <td><span class="badge bg-success">Entregado</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary btn-editar-solicitud" data-id="4" data-bs-toggle="tooltip" title="Actualizar Estatus">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>SOL-005</td>
                                <td>OT-005</td>
                                <td>ENS-100</td>
                                <td>Correa sincrónica L-150</td>
                                <td>5</td>
                                <td><span class="badge bg-warning">Urgente</span></td>
                                <td>@DateTime.Now.AddDays(-5).ToString("dd/MM/yyyy")</td>
                                <td>Roberto Díaz</td>
                                <td><span class="badge bg-danger">Rechazado</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary btn-editar-solicitud" data-id="5" data-bs-toggle="tooltip" title="Actualizar Estatus">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para nueva solicitud de refacción -->
<div class="modal fade" id="solicitudRefaccionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSolicitudTitulo">Nueva Solicitud de Refacción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formSolicitudRefaccion">
                    <input type="hidden" id="solicitudId">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="solicitudOT" class="form-label">Orden de Trabajo *</label>
                                <select class="form-select" id="solicitudOT" required>
                                    <option value="">Seleccionar OT...</option>
                                    <option value="OT-005">OT-005 - ENS-100</option>
                                    <option value="OT-008">OT-008 - MEZ-850</option>
                                    <option value="OT-012">OT-012 - HORNO-7G</option>
                                    <option value="OT-018">OT-018 - ML-2200</option>
                                    <option value="OT-022">OT-022 - CNC-789-XF</option>
                                    <option value="OT-025">OT-025 - ROB-6AX</option>
                                    <option value="OT-028">OT-028 - EMP-345</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="solicitudEquipo" class="form-label">Equipo *</label>
                                <input type="text" class="form-control" id="solicitudEquipo" readonly required>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="refaccionNombre" class="form-label">Nombre de la Refacción *</label>
                                <input type="text" class="form-control" id="refaccionNombre" required
                                       placeholder="Ej: Rodamiento axial 6008-2RS">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="refaccionCantidad" class="form-label">Cantidad *</label>
                                <input type="number" class="form-control" id="refaccionCantidad" min="1" required>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="refaccionUrgencia" class="form-label">Nivel de Urgencia *</label>
                                <select class="form-select" id="refaccionUrgencia" required>
                                    <option value="">Seleccionar urgencia...</option>
                                    <option value="Normal">Normal</option>
                                    <option value="Urgente">Urgente</option>
                                    <option value="Crítico">Crítico</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="refaccionEstatus" class="form-label">Estatus *</label>
                                <select class="form-select" id="refaccionEstatus" required>
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Autorizado">Autorizado</option>
                                    <option value="Rechazado">Rechazado</option>
                                    <option value="En tránsito">En tránsito</option>
                                    <option value="Entregado">Entregado</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="refaccionDescripcion" class="form-label">Descripción de la necesidad</label>
                        <textarea class="form-control" id="refaccionDescripcion" rows="3"
                                  placeholder="Describa por qué necesita esta refacción..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="refaccionComentarios" class="form-label">Comentarios adicionales</label>
                        <textarea class="form-control" id="refaccionComentarios" rows="2"
                                  placeholder="Comentarios adicionales..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardarSolicitud">
                    <i class="bi bi-save me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Container para alerts de Bootstrap -->
<div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999; margin-top: 70px;">
    <!-- Los alerts se insertarán aquí dinámicamente -->
</div>

<style>
    .badge {
        font-size: 0.85em;
        padding: 0.35em 0.65em;
    }

    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
</style>

<script src="~/Scripts/SR.js"></script>