@{
 Layout = null;
}
<meta charset="utf-8">

<div id="rutinaChecklist">

    <!-- seccion-duracion -->
    <div id="seccion-duracion" class="nota-seccion position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-nota position-absolute top-0 end-0 m-1 fs-4" title="Eliminar" style="display:none;">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label w-100">
            <span class="text-justify texto-actividad">PL2- PMT01- I01- F09</span>
        </label>
    </div>

    <!-- seccion-descripcion -->
    <div id="seccion-descripcion" class="nota-seccion position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-nota position-absolute top-0 end-0 m-1 fs-4" title="Eliminar" style="display:none;">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label w-100">
            <span class="text-justify texto-actividad">PL2-CAL-EMAEMG-01</span>
        </label>
    </div>

    <!-- seccion-nota-inicial -->
    <div id="seccion-nota-inicial" class="nota-seccion position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-nota position-absolute top-0 end-0 m-1 fs-4" title="Eliminar" style="display:none;">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label w-100">
            <span class="text-justify texto-actividad">Rutina de Mantenimiento Preventivo Equipo de Prueba Metileno.</span>
        </label>
    </div>


    <!-- Actividad 1 -->
    <div id="actividad-1" class="mb-3 actividad position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-actividad position-absolute top-0 end-0 m-1 fs-4" title="Eliminar">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">1.</span>
            <span class="texto-actividad">Limpieza general de refrigerador.</span>
        </label>
        <div class="d-flex gap-4 mt-2">
            <div class="firma-opcion"><span class="fw-semibold">Realizado:</span><div class="linea-firma"></div></div>
            <div class="firma-opcion"><span class="fw-semibold">No Realizado:</span><div class="linea-firma"></div></div>
        </div>
    </div>

    <!-- Actividad 2 -->
    <div id="actividad-2" class="mb-3 actividad position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-actividad position-absolute top-0 end-0 m-1 fs-4" title="Eliminar">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">2.</span>
            <span class="texto-actividad">Revisar estado de cableado eléctrico.</span>
        </label>
        <div class="d-flex gap-4 mt-2">
            <div class="firma-opcion"><span class="fw-semibold">Realizado:</span><div class="linea-firma"></div></div>
            <div class="firma-opcion"><span class="fw-semibold">No Realizado:</span><div class="linea-firma"></div></div>
        </div>
    </div>

    <!-- Actividad 3 -->
    <div id="actividad-3" class="mb-3 actividad position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-actividad position-absolute top-0 end-0 m-1 fs-4" title="Eliminar">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">3.</span>
            <span class="texto-actividad">Verificar estado y operación de puertas.</span>
        </label>
        <div class="d-flex gap-4 mt-2">
            <div class="firma-opcion"><span class="fw-semibold">Realizado:</span><div class="linea-firma"></div></div>
            <div class="firma-opcion"><span class="fw-semibold">No Realizado:</span><div class="linea-firma"></div></div>
        </div>
    </div>

    <!-- Actividad 4 -->
    <div id="actividad-4" class="mb-3 actividad position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-actividad position-absolute top-0 end-0 m-1 fs-4" title="Eliminar">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">4.</span>
            <span class="texto-actividad">Revisar estado de termopar.</span>
        </label>
        <div class="d-flex gap-4 mt-2">
            <div class="firma-opcion"><span class="fw-semibold">Realizado:</span><div class="linea-firma"></div></div>
            <div class="firma-opcion"><span class="fw-semibold">No Realizado:</span><div class="linea-firma"></div></div>
        </div>
    </div>

    <!-- Actividad 5 -->
    <div id="actividad-5" class="mb-3 actividad position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-actividad position-absolute top-0 end-0 m-1 fs-4" title="Eliminar">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">5.</span>
            <span class="texto-actividad">Verificar funcionamiento de controlador de temperatura. (anotar temp. real vs set point)</span>
        </label>
        <div class="d-flex gap-4 mt-2">
            <div class="firma-opcion"><span class="fw-semibold">Realizado:</span><div class="linea-firma"></div></div>
            <div class="firma-opcion"><span class="fw-semibold">No Realizado:</span><div class="linea-firma"></div></div>
        </div>
    </div>

    <!-- Actividad 6 -->
    <div id="actividad-6" class="mb-3 actividad position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-actividad position-absolute top-0 end-0 m-1 fs-4" title="Eliminar">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">6.</span>
            <span class="texto-actividad">Limpieza de parte inferior de refrigerador (condensador).</span>
        </label>
        <div class="d-flex gap-4 mt-2">
            <div class="firma-opcion"><span class="fw-semibold">Realizado:</span><div class="linea-firma"></div></div>
            <div class="firma-opcion"><span class="fw-semibold">No Realizado:</span><div class="linea-firma"></div></div>
        </div>
    </div>

</div>

<!-- COMENTARIOS GLOBALES -->
<div id="seccion-comentarios" class="nota-seccion position-relative p-2" draggable="true">
    <button type="button" class="btn btn-sm btn-danger btn-eliminar-nota position-absolute top-0 end-0 m-1 fs-4" title="Eliminar" style="display:none;">
        <i class="bi bi-x-circle"></i>
    </button>
    <div class="mb-3">
        <label for="Comentarios" class="form-label">Comentarios</label>
        <textarea class="form-control" id="Comentarios" rows="3" required=""></textarea>
    </div>
</div>
