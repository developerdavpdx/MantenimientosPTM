            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">2.</span>
            <span class="texto-actividad">Revisión de buril de careador, cambiar si es necesario.</span>
