            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">5.</span>
            <span class="texto-actividad">Verificar funcionamiento de controlador de temperatura. (anotar temp. real vs set point).</span>
        </label>
        <div class="d-flex gap-4 mt-2">
            <div class="firma-opcion"><span class="fw-semibold">Realizado:</span><div class="linea-firma"></div></div>
            <div class="firma-opcion"><span class="fw-semibold">No Realizado:</span><div class="linea-firma"></div></div>
