@{
 Layout = null;
}
<meta charset="utf-8">

<div id="rutinaChecklist">

    <!-- seccion-duracion -->
    <div id="seccion-duracion" class="nota-seccion position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-nota position-absolute top-0 end-0 m-1 fs-4" title="Eliminar" style="display:none;">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label w-100">
            <span class="text-justify texto-actividad">MP_ EQUIPO DE PRUEBA VICAT AECG FRECUENCIA SEMESTRAL DURACIÓN 1 HR.</span>
        </label>
    </div>

    <!-- seccion-descripcion -->
    <div id="seccion-descripcion" class="nota-seccion position-relative p-2" draggable="true">
        <button type="button" class="btn btn-sm btn-danger btn-eliminar-nota position-absolute top-0 end-0 m-1 fs-4" title="Eliminar" style="display:none;">
            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label w-100">
            <span class="text-justify texto-actividad">TODO EL MATERIAL QUE SEA UTILIZADO PARA RELIZAR AJUSTES, PRUEBAS O LIBERACION DEL EQUIPO, DEBE SER IDENTIFICADO O COLOCADO EN EL CONTENEDOR DE SCRAP DE LA ESTACION. O ENTREGADO AL DEPTO. DE CALIDAD O PRODUCCION PARA SU EVALUACION.</span>
        </label>
    </div>

