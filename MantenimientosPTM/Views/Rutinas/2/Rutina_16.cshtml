            <i class="bi bi-x-circle"></i>
        </button>
        <label class="form-label fw-semibold input-edicion-actividad">
            <span class="numero-actividad">3.</span>
            <span class="texto-actividad">[Molde] Si presenta daño realizar formato prueba de cromo.</span>
        </label>
        <div class="d-flex gap-4 mt-2">
