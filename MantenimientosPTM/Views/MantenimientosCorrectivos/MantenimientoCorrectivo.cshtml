@{
    ViewBag.Title = "Mantenimientos Correctivos Solicitados";
}

<link href="~/Content/MantenimientosPreventivos.css" rel="stylesheet" />

<!-- Tabla Principal -->
<div class="row m-0 ps-3 pt-4 pe-3 main-container position-relative header-custom">
    <div class="col-12 col-xl-12 p-0">
        <div class="card shadow">
            <div class="card-header header-fijo-custom text-dark">
                <div class="row g-2 align-items-center mb-3">
                    <!-- Título -->
                    <div class="col-12 col-lg-7">
                        <h4 class="mb-0 text-color-logo">
                            <i class="bi bi-clipboard-check-fill me-2"></i>
                            Órdenes de Trabajo Correctivo
                            <span class="text-primary ms-2" id="mesActual">@(DateTime.Now.ToString("MMMM yyyy").ToUpper())</span>
                        </h4>
                    </div>
                    <!-- Botón -->
                    @*<div class="col-12 col-lg-5">
                            <div class="d-flex flex-wrap justify-content-start justify-content-lg-end gap-2">
                                <button id="btnGenerarOrdenes" class="btn-filtro-aplicar d-flex align-items-center"
                                        data-bs-toggle="tooltip" title="Generar Órdenes de Trabajo">
                                    <i class="bi bi-file-earmark-plus-fill me-2"></i>
                                    Generar Órdenes
                                </button>
                            </div>
                        </div>*@
                </div>
            </div>
            <div class="card-body">
                <div class="filtros-panel">
                    <div class="filtros-titulo">
                        <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                        Filtros de búsqueda
                    </div>

                    <div class="row g-2 align-items-end">

                        <!-- Orden de Trabajo -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroOrdenTrabajo">
                                <i class="bi bi-file-earmark-text-fill"></i> Orden de Trabajo
                            </label>
                            <input type="text" class="filtro-input"
                                   id="FiltroOrdenTrabajo" name="FiltroOrdenTrabajo"
                                   placeholder="Buscar orden...">
                        </div>

                        <!-- Fecha Inicio -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroFechaInicio">
                                <i class="bi bi-calendar-check-fill"></i> Fecha Inicio
                            </label>
                            <input type="date" class="filtro-input"
                                   id="FiltroFechaInicio" name="FiltroFechaInicio">
                        </div>

                        <!-- Fecha Fin -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroFechaFin">
                                <i class="bi bi-calendar-x-fill"></i> Fecha Fin
                            </label>
                            <input type="date" class="filtro-input"
                                   id="FiltroFechaFin" name="FiltroFechaFin">
                        </div>

                        <!-- Proceso -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroArea">
                                <i class="bi bi-gear-fill"></i> Proceso
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroArea" name="FiltroArea">
                                    <option value="">Todos los procesos...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroArea">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Línea de Producción -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroLinea">
                                <i class="bi bi-diagram-3-fill"></i> Línea de Producción
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroLinea" name="FiltroLinea" disabled>
                                    <option value="">Todas las líneas...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroLinea">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-auto d-flex align-items-end gap-2">
                            <button type="button" class="btn-filtro-aplicar"
                                    id="btnAplicarFiltros" title="Aplicar filtros">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>
                            <button type="button" class="btn-filtro-limpiar"
                                    id="btnLimpiarFiltros" title="Limpiar filtros">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Limpiar
                            </button>
                        </div>

                    </div>
                </div>
                <!-- Tabla -->
                <div id="tablaMantenimientosRangoContainer" class="table-responsive small table-responsive-custom">
                    <table class="table table-striped table-sm CustomTableResponsive" id="tablaMantenimientosRango">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col">
                                    <input type="checkbox" id="selectAll" data-bs-toggle="tooltip" title="Seleccionar todos">
                                </th>
                                <th scope="col" class="col-actions">Acciones</th>
                                <th scope="col">Número Orden</th>
                                <th scope="col">Equipo</th>
                                <th scope="col">Proceso</th>
                                <th scope="col">Línea</th>
                                <th scope="col">Estatus Orden</th>
                                <th scope="col">Fecha Solicitud Mantenimiento</th>
                                <th scope="col">Hora Apertura</th>
                                <th scope="col">Hora Cierre</th>
                                <th scope="col">Tiempo Invertido (Hrs)</th>
                                <th scope="col">Texto Breve</th>
                                <th scope="col">Solicitante</th>
                                <th scope="col" class="col-text-long">Comentarios</th>
                                <th scope="col">Tipo Mantenimiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="filaVacia">
                                <td colspan="16" class="text-center">
                                    <!-- 👈 Cambiar de 16 a 15 -->
                                    <i class="bi bi-funnel"></i> Aplica los filtros para ver los mantenimientos
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL SOLICITAR REFACCIÓN PARA ORDEN DE TRABAJO
══════════════════════════════════════════════ -->
<div class="modal fade" id="solicitarRefaccionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-cart-plus-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">Solicitar Refacción</div>
                        <div class="modal-subtitle-custom">Para Orden de Trabajo</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="formSolicitarRefaccion" class="needs-validation" novalidate autocomplete="on">
                <div class="modal-body-custom">

                    <!-- Sección 1: Información de la Orden -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color:var(--modal-primary); font-weight:700;">
                            <i class="bi bi-file-earmark-text-fill me-2"></i>Información de la Orden
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="ROT">
                                    <i class="bi bi-hash"></i> Orden de Trabajo
                                </label>
                                <input type="text" class="form-control-custom" id="ROT" readonly autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="RFechaMantenimiento">
                                    <i class="bi bi-calendar-event"></i> Fecha de Solicitud
                                </label>
                                <input type="text" class="form-control-custom" id="RFechaMantenimiento" readonly autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="REquipo">
                                    <i class="bi bi-gear-fill"></i> Equipo
                                </label>
                                <input type="text" class="form-control-custom" id="REquipo" readonly autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="RLinea">
                                    <i class="bi bi-arrow-repeat"></i> Línea
                                </label>
                                <input type="text" class="form-control-custom" id="RLinea" readonly autocomplete="off">
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 2: Detalles de la Refacción -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color:var(--modal-primary); font-weight:700;">
                            <i class="bi bi-box-seam-fill me-2"></i>Detalles de la Refacción
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <!-- Buscador de artículos -->
                                <div class="row g-3 mb-3">
                                    <div class="col-12">
                                        <label class="form-label-custom" for="BuscarArticuloMC">
                                            <i class="bi bi-search"></i> Buscar Artículo <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control-custom" id="BuscarArticuloMC" name="BuscarArticuloMC"
                                               placeholder="Búsqueda mediante código de artículo, nombre, descripción..." autocomplete="off">
                                        <div id="sugerenciasArticulosMC" class="autocomplete-sugerencias"></div>
                                    </div>
                                </div>

                                <!-- Campos ocultos para storing temporal del artículo seleccionado -->
                                <input type="hidden" id="CodigoArticuloMC" name="CodigoArticuloMC">
                                <input type="hidden" id="DescripcionArticuloMC" name="DescripcionArticuloMC">

                                <!-- Tabla de artículos agregados -->
                                <div class="table-responsive" style="max-height: 250px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px;">
                                    <table class="table table-sm table-hover mb-0 CustomTableResponsive" id="tablaArticulosRefaccionMC">
                                        <thead class="table-light text-center position-sticky top-0" style="z-index: 1;">
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th>Código</th>
                                                <th>Descripción</th>
                                                <th style="width: 120px;">Cantidad <span class="text-danger">*</span></th>
                                                <th style="width: 60px;">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody id="bodyArticulosRefaccionMC">
                                            <tr id="filaSinArticulosMC">
                                                <td colspan="5" class="text-center text-muted py-3">
                                                    <i class="bi bi-info-circle me-1"></i>Busque y seleccione un artículo para agregarlo
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="modal-error-msg" id="errorArticulosMC" style="display: none;">
                                    ⚠️ Agregue al menos un artículo a la solicitud.
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 3: Prioridad y Justificación -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color:var(--modal-primary); font-weight:700;">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Prioridad y Justificación
                        </h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label-custom" for="RdescripcionNecesidad">
                                    <i class="bi bi-chat-left-text-fill"></i> Descripción de la Necesidad <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control-custom" id="RdescripcionNecesidad" rows="3"
                                          placeholder="Describa por qué necesita esta refacción..."
                                          required autocomplete="on"></textarea>
                                <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Describa por qué necesita la refacción.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Alerta Container -->
                    <div id="alertRefaccionContainer"></div>

                </div>

                <!-- ── Footer ── -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn-modal-guardar" id="btnSolicitarRefaccion">
                        <i class="bi bi-send-fill me-1"></i> Enviar Solicitud
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL ORDEN DE MANTENIMIENTO CORRECTIVO
══════════════════════════════════════════════ -->
<div class="modal fade" id="modalOrdenMantenimiento" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">Orden de Mantenimiento Correctivo</div>
                        <div class="modal-subtitle-custom">Complete los datos para registrar la orden</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Formulario ── -->
            <form id="formOrdenMantenimiento" class="needs-validation" novalidate autocomplete="on">
                <div class="modal-body-custom">
                    <div class="documento-papel bg-white rounded p-4" style="border: 1px solid var(--modal-border);">

                        <!-- Header del documento -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <img src="~/Content/Images/LogoPTM.png" alt="Logo PTM" style="height:50px; width:auto;">
                            <div class="text-end">
                                <i class="bi bi-calendar3 me-2" style="color:var(--modal-primary);"></i>
                                <strong class="me-1">Fecha:</strong>
                                <span id="fechaImpresion"></span>
                            </div>
                        </div>
                        <hr class="divider-custom">

                        <!-- Banner Tipo de Mantenimiento -->
                        <div class="modal-banner-warning mb-4">
                            <i class="bi bi-exclamation-triangle-fill" style="font-size:1.2rem; flex-shrink:0;"></i>
                            <div>
                                <h6 class="fw-bold mb-1">
                                    <i class="bi bi-wrench-adjustable me-1"></i>Tipo de Mantenimiento
                                </h6>
                                <p class="mb-1 fw-semibold">MANTENIMIENTO MAQUINARIA E INSTALACIONES</p>
                                <p class="mb-0">REPARACIÓN MANTENIMIENTO CORRECTIVO</p>
                            </div>
                        </div>

                        <!-- Sección 1: Datos de la Orden -->
                        <div class="mb-4">
                            <h6 class="mb-3 pb-2 border-bottom" style="color:var(--modal-primary); font-weight:700;">
                                <i class="bi bi-clipboard-data-fill me-2"></i>Datos de la Orden
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="NumeroOrden">
                                        <i class="bi bi-hash"></i> Número de Orden
                                    </label>
                                    <input type="text" class="form-control-custom" id="NumeroOrden" name="NumeroOrden" readonly autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="Solicitante">
                                        <i class="bi bi-person-check-fill"></i> Solicitante <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="Solicitante" name="Solicitante"
                                           placeholder="Nombre del operador" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese el nombre del solicitante.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="NominaSolicitante">
                                        <i class="bi bi-123"></i> Número Nómina <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="NominaSolicitante" name="NominaSolicitante"
                                           placeholder="# de nómina" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese el número de nómina.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="EstatusOrden">
                                        <i class="bi bi-activity"></i> Estatus de la Orden
                                    </label>
                                    <input type="text" class="form-control-custom" id="EstatusOrden" name="EstatusOrden" readonly autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="FechaInicioExtrema">
                                        <i class="bi bi-calendar-check-fill"></i> Fecha Inicio Extrema
                                    </label>
                                    <input type="date" class="form-control-custom" id="FechaInicioExtrema" name="FechaInicioExtrema" readonly autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="HoraInicio">
                                        <i class="bi bi-clock-fill"></i> Hora Apertura
                                    </label>
                                    <input type="time" class="form-control-custom" id="HoraInicio" name="HoraInicio" readonly autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="UbicacionTecnica">
                                        <i class="bi bi-geo-alt-fill"></i> Ubicación Técnica
                                    </label>
                                    <input type="text" class="form-control-custom" id="UbicacionTecnica" name="UbicacionTecnica" readonly autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="TipoMantenimiento">
                                        <i class="bi bi-wrench-adjustable-circle-fill"></i> Tipo de Mantenimiento
                                    </label>
                                    <input type="text" class="form-control-custom" id="TipoMantenimiento" name="TipoMantenimiento" readonly autocomplete="off">
                                </div>
                                <div class="col-12">
                                    <label class="form-label-custom" for="TextoCorto">
                                        <i class="bi bi-chat-left-text-fill"></i> Texto Corto <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="TextoCorto" name="TextoCorto"
                                           placeholder="Descripción corta de la falla" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese el texto corto descriptivo.</div>
                                </div>
                            </div>
                        </div>

                        <hr class="divider-custom">

                        <!-- Sección 2: Datos del Equipo -->
                        <div class="mb-4">
                            <h6 class="mb-3 pb-2 border-bottom" style="color:var(--modal-primary); font-weight:700;">
                                <i class="bi bi-gear-wide-connected me-2"></i>Datos del Equipo
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="ClaseMantenimiento">
                                        <i class="bi bi-tag-fill"></i> Clase de Mantenimiento <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="ClaseMantenimiento" name="ClaseMantenimiento" value="Z10" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese la clase de mantenimiento.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="NombreEquipo">
                                        <i class="bi bi-gear-fill"></i> Nombre Equipo <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="NombreEquipo" name="NombreEquipo"
                                           placeholder="Nombre del equipo" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese el nombre del equipo.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="DescEquipo">
                                        <i class="bi bi-card-text"></i> Descripción Equipo <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="DescEquipo" name="DescEquipo"
                                           placeholder="Descripción del equipo" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese la descripción del equipo.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="CentroCostos">
                                        <i class="bi bi-cash-coin"></i> Centro Costos <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="CentroCostos" name="CentroCostos"
                                           placeholder="Centro de costos" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese el centro de costos.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="NumDocPmCalidad">
                                        <i class="bi bi-file-earmark-check-fill"></i> Número Doc PM Calidad <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="NumDocPmCalidad" name="NumDocPmCalidad"
                                           placeholder="# Doc pm.calidad" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese el número de documento PM Calidad.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="Linea">
                                        <i class="bi bi-arrow-repeat"></i> Línea <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-custom" id="Linea" name="Linea" readonly autocomplete="off">
                                    <div class="modal-error-msg"><img src="~/Content/Images/alerta.gif" width="24" class"me-3"> Por favor ingrese la línea.</div>
                                </div>
                            </div>
                        </div>

                        <hr class="divider-custom">

                        <!-- Sección 3: Registro de Trabajo -->
                        <div id="CierreOrdenTrabajo" class="mb-4">
                            <h6 class="mb-3 pb-2 border-bottom" style="color:var(--modal-primary); font-weight:700;">
                                <i class="bi bi-wrench-adjustable-circle-fill me-2"></i>Registro de Trabajo
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom" for="HoraInicioTrabajo">
