<div class="modal fade" id="actualizacionDatosModal" tabindex="-1" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-arrow-clockwise"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">Actualización disponible</div>
                        <div class="modal-subtitle-custom">Mantenimientos preventivos</div>
                    </div>
                </div>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="alert"
                     style="border-radius: 8px; font-size: 0.875rem;">
                    <i class="bi bi-info-circle-fill mt-1 flex-shrink-0"></i>
                    <div>
                        <strong>Se detectaron cambios</strong> en los datos de mantenimientos correctivos
                        desde tu última carga.<br>
                        ¿Deseas recargar la tabla ahora para ver la información actualizada?
                    </div>
                </div>

                <p class="text-muted mb-0" style="font-size: 0.8125rem;">
                    <i class="bi bi-clock me-1"></i>
                    Los cambios se aplicarán sin perder tu rango de fechas seleccionado.
                </p>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal"
                        id="btnCancelarActualizacion">
                    <i class="bi bi-x-circle me-1"></i> Ahora no
                </button>
                <button type="button" class="btn-modal-guardar" id="btnConfirmarActualizacion">
                    <i class="bi bi-arrow-clockwise me-1"></i> Sí, recargar
                </button>
            </div>

        </div>
    </div>
</div>


