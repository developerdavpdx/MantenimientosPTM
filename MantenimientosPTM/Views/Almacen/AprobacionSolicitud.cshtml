@{
    Layout = null;
    ViewBag.Title = "Aprobación de Solicitud de Compra";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - PTM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="~/Content/SolicitudRefacciones.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
        }
        .aprobacion-container {
            max-width: 600px;
            margin: 50px auto;
        }
        .aprobacion-card {
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .aprobacion-header {
            padding: 30px;
            text-align: center;
        }
        .aprobacion-header.success {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        }
        .aprobacion-header.danger {
            background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
        }
        .aprobacion-header.warning {
            background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
        }
        .aprobacion-header.error {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        }
        .aprobacion-icon {
            font-size: 60px;
            color: white;
        }
        .aprobacion-body {
            padding: 40px;
            text-align: center;
        }
        .aprobacion-title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin-bottom: 15px;
        }
        .aprobacion-message {
            font-size: 16px;
            color: #666;
            line-height: 1.6;
        }
        .aprobacion-badge {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: bold;
            margin-top: 20px;
        }
        .badge-aprobado {
            background-color: #d4edda;
            color: #155724;
        }
        .badge-no-aprobado {
            background-color: #f8d7da;
            color: #721c24;
        }
        .badge-pendiente {
            background-color: #fff3cd;
            color: #856404;
        }
        .badge-error {
            background-color: #e2e3e5;
            color: #383d41;
        }
        .btn-ptm {
            display: inline-block;
            padding: 12px 30px;
            background-color: #1976D2;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            margin-top: 25px;
            font-weight: bold;
        }
        .btn-ptm:hover {
            background-color: #1565C0;
            color: white;
        }
    </style>
</head>
<body data-require-auth="false">
    <div class="container-fluid pt-4">
        <div class="aprobacion-container">
            <div class="card aprobacion-card">
                
                @{
                    string headerClass = "";
                    string iconClass = "";
                    string badgeClass = "";
                    
                    if (ViewBag.Estado == "Aprobado")
                    {
                        headerClass = "success";
                        iconClass = "bi-check-circle-fill";
                        badgeClass = "badge-aprobado";
                    }
                    else if (ViewBag.Estado == "No Aprobado")
                    {
                        headerClass = "danger";
                        iconClass = "bi-x-circle-fill";
                        badgeClass = "badge-no-aprobado";
                    }
                    else if (ViewBag.Estado == "Espera Autorizacion" || ViewBag.Estado == "Pendiente")
                    {
                        headerClass = "warning";
                        iconClass = "bi-hourglass-split";
                        badgeClass = "badge-pendiente";
                    }
                    else
                    {
                        headerClass = "error";
                        iconClass = "bi-exclamation-triangle-fill";
                        badgeClass = "badge-error";
                    }
                }
                
                <div class="aprobacion-header @headerClass">
                    <i class="bi @iconClass aprobacion-icon"></i>
                </div>
                
                <div class="aprobacion-body">
                    <div class="aprobacion-title">
                        @(ViewBag.Mensaje ?? "Resultado de la solicitud")
                    </div>
                    
                    @if (!string.IsNullOrEmpty(ViewBag.Folio))
                    {
                        <p class="text-muted mb-3">
                            <strong>Folio:</strong> @ViewBag.Folio
                        </p>
                    }
                    
                    <span class="aprobacion-badge @badgeClass">
                        @ViewBag.Estado
                    </span>
                    
                    <div>
                        <a href="@Url.Action("SolicitudOC", "Almacen")" class="btn-ptm">
                            <i class="bi bi-arrow-left me-2"></i>Ir a Solicitudes de Compra
                        </a>
                    </div>
                </div>
                
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>