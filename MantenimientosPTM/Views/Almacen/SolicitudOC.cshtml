@{
    ViewBag.Title = "Solicitudes de Compra SAP";
}

<link href="~/Content/SolicitudRefacciones.css" rel="stylesheet" />

<!-- ══════════════════════════════════════════════
     CARD PRINCIPAL
══════════════════════════════════════════════ -->
<div class="row m-0 ps-3 pt-4 pe-3 pb-4 position-relative header-custom">
    <div class="col-12 p-0">
        <div class="card shadow">

            <!-- ── Card Header ── -->
            <div class="card-header header-fijo-custom text-dark">
                <div class="row g-3 align-items-center">

                    <!-- Título -->
                    <div class="col-12 col-sm-6 col-md-12 text-center text-sm-start">
                        <h4 class="mb-0 text-color-logo">
                            <i class="bi bi-cart-check me-2"></i>
                            Solicitud de Compra
                        </h4>
                    </div>
                </div>
            </div>

            <!-- ── Filtros + Tabla ── -->
            <div class="row m-0 pt-3 pb-3">
                <div class="col-12 mb-3 mb-lg-0">
                    <form id="formFiltrosSolicitudesCompra" autocomplete="on">
                        <div class="filtros-panel">
                            <div class="filtros-titulo">
                                <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                                Filtros de búsqueda
                            </div>
                            <div class="row g-2 align-items-end">
                                <!-- Fecha Inicio -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroFechaInicio">
                                        <i class="bi bi-calendar-check-fill"></i> Fecha Inicio
                                    </label>
                                    <input type="date" class="filtro-input"
                                           id="FiltroFechaInicio" name="FiltroFechaInicio">
                                </div>
                                <!-- Fecha Fin -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroFechaFin">
                                        <i class="bi bi-calendar-x-fill"></i> Fecha Fin
                                    </label>
                                    <input type="date" class="filtro-input"
                                           id="FiltroFechaFin" name="FiltroFechaFin">
                                </div>
                                <!-- Folio Solicitud Compra -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroFolio">
                                        <i class="bi bi-cash-stack"></i> Folio
                                    </label>
                                    <input type="text" class="filtro-input"
                                           id="FiltroFolio" name="FiltroFolio"
                                           placeholder="Buscar folio...">
                                </div>
                                <!-- Botones -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-auto d-flex align-items-end gap-2">
                                    <button type="button"
                                            class="btn-filtro-aplicar"
                                            id="btnAplicarFiltros"
                                            title="Aplicar filtros">
                                        <i class="bi bi-search"></i>
                                        Buscar
                                    </button>
                                    <button type="button"
                                            class="btn-filtro-limpiar"
                                            id="btnLimpiarFiltros"
                                            title="Limpiar filtros">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        Limpiar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <!-- Tabla -->
                    <div class="table-responsive small table-responsive-custom" id="tablaSolicitudesCompraContainer">
                        <table class="table table-striped table-sm CustomTableResponsive" id="tablaSolicitudesCompra">
                            <thead class="table-light text-center">
                                <tr>
                                    <th></th>
                                    <th>Acciones</th>
                                    <th>Folio</th>
                                    <th>OT(s)</th>
                                    <th>Fecha Solicitud</th>
                                    <th>Estado</th>
                                    <th>Usuario Solicita</th>
                                    <th>Comentarios</th>
                                    <th>Doc. SAP</th>
                                    <th>Doc. Entry</th>
                                    <th>SAP</th>
                                    <th>Comentarios Rechazo</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<!-- ══════════════════════════════════════════════
     MODAL: DETALLE SOLICITUD DE COMPRA
══════════════════════════════════════════════ -->
<div class="modal fade" id="modalDetalleSolicitudCompra" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-cart-check-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalDetalleSolicitudCompraLabel">Detalle Solicitud de Compra</div>
                        <div class="modal-subtitle-custom">Información completa de la solicitud</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">
                            <i class="bi bi-file-earmark-text-fill"></i> Orden de Trabajo
                        </label>
                        <input type="text" class="form-control-custom" id="detalleOrdenTrabajo" readonly>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label-custom">
                            <i class="bi bi-123"></i> Cantidad
                        </label>
                        <input type="text" class="form-control-custom" id="detalleCantidad" readonly>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label-custom">
                            <i class="bi bi-exclamation-triangle-fill"></i> Nivel Urgencia
                        </label>
                        <input type="text" class="form-control-custom" id="detalleNivelUrgencia" readonly>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">
                            <i class="bi bi-wrench-adjustable"></i> Refacción Solicitada
                        </label>
                        <input type="text" class="form-control-custom" id="detalleRefaccion" readonly>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">
                            <i class="bi bi-chat-left-text-fill"></i> Comentarios
                        </label>
                        <input type="text" class="form-control-custom" id="detalleComentarios" readonly>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">
                            <i class="bi bi-toggle-on"></i> Estatus
                        </label>
                        <input type="text" class="form-control-custom" id="detalleEstatus" readonly>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">
                            <i class="bi bi-calendar-event-fill"></i> Fecha Solicitud
                        </label>
                        <input type="text" class="form-control-custom" id="detalleFechaSolicitud" readonly>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">
                            <i class="bi bi-calendar-check-fill"></i> Fecha Atención
                        </label>
                        <input type="text" class="form-control-custom" id="detalleFechaAtencion" readonly>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">
                            <i class="bi bi-person-fill"></i> Usuario Solicita
                        </label>
                        <input type="text" class="form-control-custom" id="detalleUsuarioSolicita" readonly>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">
                            <i class="bi bi-person-check-fill"></i> Usuario Atiende
                        </label>
                        <input type="text" class="form-control-custom" id="detalleUsuarioAtiende" readonly>
                    </div>
                </div>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cerrar
                </button>
            </div>

        </div>
    </div>
</div>


<!-- ══════════════════════════════════════════════
     MODAL: SOLICITUDES DE REFACCIONES (listado)
══════════════════════════════════════════════ -->
<div class="modal fade" id="SolRefModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-90">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-list-task"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">Solicitudes de Refacciones</div>
                        <div class="modal-subtitle-custom">Detalle de solicitudes asociadas</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <!-- Tabla -->
                <div class="table-responsive small table-responsive-custom" id="tablaSolicitudesContainer">
                    <table class="table table-striped table-sm CustomTableResponsive" id="tablaSolicitudesRefacciones">
                        <thead class="table-light text-center">
                            <tr>
                                <th></th>

                                <th>
                                    <i class="bi bi-tools me-1"></i>
                                    OT
                                </th>

                                <th>
                                    <i class="bi bi-upc-scan me-1"></i>
                                    Código
                                </th>

                                <th>
                                    <i class="bi bi-box-seam me-1"></i>
                                    Artículo
                                </th>

                                <th>
                                    <i class="bi bi-sort-numeric-up me-1"></i>
                                    Requerida
                                </th>

                                <th>
                                    <i class="bi bi-cart-plus me-1"></i>
                                    Encargar
                                </th>

                                <th>
                                    <i class="bi bi-box-seam me-1"></i>
                                    Stock
                                </th>

                                <th>
                                    <i class="bi bi-arrow-down-circle me-1"></i>
                                    Min
                                </th>

                                <th>
                                    <i class="bi bi-arrow-up-circle me-1"></i>
                                    Max
                                </th>

                                <th>
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Urgencia
                                </th>

                                <th>
                                    <i class="bi bi-card-text me-1"></i>
                                    Descripción
                                </th>

                                <th>
                                    <i class="bi bi-calendar-event me-1"></i>
                                    Fecha
                                </th>

                                <th>
                                    <i class="bi bi-flag-fill me-1"></i>
                                    Estatus
                                </th>

                                <th>
                                    <i class="bi bi-person-fill me-1"></i>
                                    Usuario
                                </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-guardar" data-bs-dismiss="modal">
                    <i class="bi bi-check-lg me-1"></i> OK
                </button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_ModalRequisionCompra")


<!-- ══════════════════════════════════════════════
     MODAL: DETALLE DE SOLICITUD (SC)
══════════════════════════════════════════════ -->
<div class="modal fade" id="detalleSCModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-card-list"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="detalleSCModalLabel">Detalle de Solicitud</div>
                        <div class="modal-subtitle-custom">Artículos y cantidades de la solicitud</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <div id="detalleSCContent">
                    <!-- Se llena dinámicamente -->
                </div>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL ACTUALIZACIÓN DE DATOS — SOLICITUD DE COMPRA
═══════════════════════════════════════════════════ -->
<div class="modal fade actualizacionDatosModal" id="actualizacionRefaccionesModal" tabindex="-1" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-arrow-clockwise"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">Actualización disponible</div>
                        <div class="modal-subtitle-custom">Solicitud Refacciones</div>
                    </div>
                </div>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="alert"
                     style="border-radius: 8px; font-size: 0.875rem;">
                    <i class="bi bi-info-circle-fill mt-1 flex-shrink-0"></i>
                    <div>
                        <strong>Se detectaron cambios</strong> en los datos de solicitudes de compra
                        desde tu última carga.<br>
                        ¿Deseas recargar la tabla ahora para ver la información actualizada?
                    </div>
                </div>

                <p class="text-muted mb-0" style="font-size: 0.8125rem;">
                    <i class="bi bi-clock me-1"></i>
                    Los cambios se aplicarán sin perder tu rango de fechas seleccionado.
                </p>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal"
                        id="btnCancelarActualizacion">
                    <i class="bi bi-x-circle me-1"></i> Ahora no
                </button>
                <button type="button" class="btn-modal-guardar" id="btnConfirmarActualizacion">
                    <i class="bi bi-arrow-clockwise me-1"></i> Sí, recargar
                </button>
            </div>

        </div>
    </div>
</div>


<!-- Container para alerts -->
<div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999; margin-top: 70px;"></div>

<!-- Loader fullscreen -->
<div id="calendarLoader" style="display: none;">
    <div class="calendar-loader-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-white fw-semibold">Cargando solicitudes, por favor espere...</p>
    </div>
</div>

<!-- ✅ VARIABLE GLOBAL PARA IDENTIFICAR LA VISTA -->
<script>
    window.CURRENT_VIEW = 'SolicitudCompra'; // Identificar que estamos en Solicitud de Compra
</script>
<script src="~/Scripts/solicitud_ordenes_compra_refactor.js?=v1.2.1"></script>
