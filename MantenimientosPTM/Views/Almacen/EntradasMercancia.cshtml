@{
    ViewBag.Title = "Solicitudes de Refacciones";
}

<link href="~/Content/SolicitudRefacciones.css" rel="stylesheet" />

<!-- ══════════════════════════════════════════════
     CARD PRINCIPAL
══════════════════════════════════════════════ -->
<div class="row m-0 ps-3 pt-4 pe-3 pb-4 position-relative header-custom">
    <div class="col-12 p-0">
        <div class="card shadow">

            <!-- ── Card Header ── -->
            <div class="card-header header-fijo-custom text-dark">
                <div class="row g-2 align-items-center mb-3">
                    <!-- Título -->
                    <div class="col-12 col-lg-4">
                        <h4 class="mb-0 text-color-logo">
                            <i class="bi bi-currency-dollar me-2"></i>Ordenes Compra
                        </h4>
                    </div>

                    <!-- Botones -->
                    <div class="col-12 col-lg-8">
                        <div class="d-flex flex-wrap justify-content-start justify-content-lg-end gap-2">
                            <a href="#" id="btnGenerarEntradaMercancia" class="btn btn-primary" title="Agregar Entrada Mercancía">
                                <i class="bi bi-journal-arrow-down"></i> Entrada Mercancía
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ── Filtros + Tabla ── -->
            <div class="row m-0 pt-3 pb-3">
                <div class="col-12 mb-3 mb-lg-0">
                    <form id="formFiltrosSolicitudes" autocomplete="on">
                        <div class="filtros-panel">

                            <div class="filtros-titulo">
                                <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                                Filtros de búsqueda
                            </div>

                            <div class="row g-2 align-items-end">

                                <!-- Orden de Trabajo -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroOC">
                                        <i class="bi bi-file-earmark-text-fill"></i> Orden Compra
                                    </label>
                                    <input type="text" class="filtro-input"
                                           id="FiltroOC" name="FiltroOC"
                                           placeholder="Buscar OC...">
                                </div>

                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroCN">
                                        <i class="bi bi-file-earmark-text-fill"></i> Proveedor
                                    </label>
                                    <input type="text" class="filtro-input"
                                           id="FiltroCN" name="FiltroCN"
                                           placeholder="Buscar Proveedor...">
                                </div>

                                <!-- Fecha Inicio -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroFechaInicio">
                                        <i class="bi bi-calendar-check-fill"></i> Fecha Inicio
                                    </label>
                                    <input type="date" class="filtro-input"
                                           id="FiltroFechaInicio" name="FiltroFechaInicio">
                                </div>

                                <!-- Fecha Fin -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroFechaFin">
                                        <i class="bi bi-calendar-x-fill"></i> Fecha Fin
                                    </label>
                                    <input type="date" class="filtro-input"
                                           id="FiltroFechaFin" name="FiltroFechaFin">
                                </div>

                                <!-- Planta -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroPlanta">
                                        <i class="bi bi-building-fill"></i> Planta
                                    </label>
                                    <select class="filtro-input" id="FiltroPlanta" name="FiltroPlanta">
                                        <option value="">Todas las plantas...</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                    </select>
                                </div>

                                <!-- Botones -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-auto d-flex align-items-end gap-2">
                                    <button type="button"
                                            class="btn-filtro-aplicar"
                                            id="btnAplicarFiltros"
                                            title="Aplicar filtros">
                                        <i class="bi bi-search"></i>
                                        Buscar
                                    </button>
                                    <button type="button"
                                            class="btn-filtro-limpiar"
                                            id="btnLimpiarFiltros"
                                            title="Limpiar filtros">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        Limpiar
                                    </button>
                                </div>

                            </div>
                        </div>
                    </form>

                    <!-- Tabla -->
                    <div class="table-responsive small table-responsive-custom" id="tablaSolicitudesContainer">
                        <table class="table table-striped table-sm CustomTableResponsive" id="tablaOrdenesCompra">
                            <thead class="table-light text-center">
                                <tr>
                                    <!-- Col 0: Control Responsive -->
                                    <th></th>
                                    <!-- Col 1: Acciones -->
                                    <th class="text-center">Acciones</th>
                                    <!-- Col 2: N° OC -->
                                    <th class="text-center">N° OC</th>
                                    <!-- Col 3: Código Proveedor (oculta por defecto) -->
                                    <th class="text-center">Código Proveedor</th>
                                    <!-- Col 4: Proveedor -->
                                    <th>Proveedor</th>
                                    <!-- Col 5: Fecha Documento -->
                                    <th class="text-center">Fecha Documento</th>
                                    <!-- Col 6: Fecha Vencimiento -->
                                    <th class="text-center">Fecha Vencimiento</th>
                                    <!-- Col 7: Comentarios -->
                                    <th>Comentarios</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL: ENTRADA DE MERCANCÍA
══════════════════════════════════════════════ -->
<div class="modal fade" id="entradaMercancia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">Entrada de Mercancía</div>
                        <div class="modal-subtitle-custom">Registra los datos del documento de entrada</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <form id="formDocumento">

                    <!-- Datos Generales -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-info-circle-fill me-2"></i>Datos Generales
                        </h6>
                        <div class="row g-3">

                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="nombreProv">
                                    <i class="bi bi-person-vcard-fill"></i> Nombre Proveedor <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control-custom" id="nombreProv" name="Solicitante"
                                       placeholder="Nombre del proveedor" required>
                                <div class="modal-error-msg">⚠️ Por favor ingrese el nombre del proveedor.</div>
                                <div class="list-group position-absolute col-12 col-md-4 d-none" id="acNombre"></div>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="codigoProv">
                                    <i class="bi bi-person-video2"></i> Código Proveedor <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control-custom" id="codigoProv" name="Proveedor"
                                       placeholder="Código de proveedor" required>
                                <div class="modal-error-msg">⚠️ Por favor ingrese el código del proveedor.</div>
                            </div>

                            <div class="col-12 col-md-4 position-relative">
                                <label class="form-label-custom" for="ordenCompra">
                                    <i class="bi bi-coin"></i> Orden de Compra <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control-custom" id="ordenCompra" name="Orden Compra"
                                       placeholder="Orden de compra" autocomplete="off" required>
                                <div class="modal-error-msg">⚠️ Por favor ingrese la orden de compra.</div>
                                <div class="list-group position-absolute col-12 col-md-12 d-none" id="acOC"></div>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="FechaCount">
                                    <i class="bi bi-calendar-event"></i> Fecha Contabilización <span class="text-danger">*</span>
                                </label>
                                <input type="date" class="form-control-custom" id="FechaCount"
                                       name="Fecha contabilización" required>
                                <div class="modal-error-msg">⚠️ Por favor ingrese una fecha.</div>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="FechaV">
                                    <i class="bi bi-calendar-x-fill"></i> Fecha Vencimiento <span class="text-danger">*</span>
                                </label>
                                <input type="date" class="form-control-custom" id="FechaV"
                                       name="Fecha vencimiento" required>
                                <div class="modal-error-msg">⚠️ Por favor ingrese la fecha de vencimiento.</div>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="FechaDoc">
                                    <i class="bi bi-calendar2-range-fill"></i> Fecha Documento <span class="text-danger">*</span>
                                </label>
                                <input type="date" class="form-control-custom" id="FechaDoc"
                                       name="Fecha documento" required>
                                <div class="modal-error-msg">⚠️ Por favor ingrese la fecha del documento.</div>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="NoEntrada">
                                    <i class="bi bi-hash"></i> N° Entrada <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control-custom" id="NoEntrada"
                                       name="Número Entrada" readonly required value="231244">
                                <div class="modal-error-msg">⚠️ Campo requerido.</div>
                            </div>

                            <div class="col-12 col-md-8">
                                <label class="form-label-custom">
                                    <i class="bi bi-cash-coin"></i> Tipo de Cambio <span class="text-danger">*</span>
                                </label>
                                <div class="d-flex gap-2">
                                    <select class="form-select-custom" id="inputMonedaSN">
                                        <option selected>Moneda SN</option>
                                        <option value="1">Moneda del sistema</option>
                                        <option value="2">Moneda local</option>
                                    </select>
                                    <select class="form-select-custom" id="inputDivisa">
                                        <option selected>USD</option>
                                        <option value="MXP">MXP</option>
                                        <option value="CAN">CAN</option>
                                        <option value="EUR">EUR</option>
                                        <option value="FRA">FRA</option>
                                    </select>
                                    <input class="form-control-custom" id="inputValMoneda" type="number" required value="17.23">
                                </div>
                            </div>

                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Tabla de artículos -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-table me-2"></i>Detalle de Artículos
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle sap-table" id="tablaArticulos">
                                <thead class="table-light text-center">
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>N° Artículo</th>
                                        <th>Descripción</th>
                                        <th>Cantidad</th>
                                        <th>Lote</th>
                                        <th>Folio Fact.</th>
                                        <th>Precio U.</th>
                                        <th>% Desc.</th>
                                        <th>IVA</th>
                                        <th>Total</th>
                                        <th>Almacén</th>
                                        <th>Departamento</th>
                                        <th>Proceso</th>
                                        <th>Gastos</th>
                                        <th>Cedes</th>
                                        <th>Cód. Op.</th>
                                        <th>Unidad</th>
                                        <th>Art./Unidad</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="w-100 text-start fs-4" id="TotalEM"></div>
                    </div>

                </form>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
                <button type="button" class="btn-modal-guardar" id="SaveEM">
                    <i class="bi bi-floppy-fill me-1"></i> Guardar
                </button>
            </div>

        </div>
    </div>
</div>


<!-- Container para alerts -->
<div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999; margin-top: 70px;"></div>

<!-- Loader fullscreen -->
<div id="calendarLoader" style="display: none;">
    <div class="calendar-loader-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-primary fw-semibold">Cargando equipos, por favor espere...</p>
    </div>
</div>

<script src="~/Scripts/entrada_mercancia_refactor.js"></script>
