@{
    ViewBag.Title = "Solicitudes de Refacciones";
}

<link href="~/Content/SolicitudRefacciones.css" rel="stylesheet" />

<!-- ══════════════════════════════════════════════
     CARD PRINCIPAL
══════════════════════════════════════════════ -->
<div class="row m-0 ps-3 pt-4 pe-3 pb-4 position-relative header-custom">
    <div class="col-12 p-0">
        <div class="card shadow">

            <!--── Card Header ── -->
            <div class="card-header header-fijo-custom text-dark">
                <div class="row g-2 align-items-center mb-3">
                    <!-- Título -->
                    <div class="col-12 col-lg-4">
                        <h4 class="mb-0 text-color-logo">
                            <i class="bi bi-tools me-2"></i>Solicitud de Refacciones
                        </h4>
                    </div>
                    <!-- Botones -->
                    <div class="col-12 col-lg-8">
                        <div class="d-flex flex-wrap justify-content-start justify-content-lg-end gap-2">
                            <a href="#" id="btnGenerarSolicitudCompra" class="btn btn-primary" title="Agregar Solicitud Compra">
                                <i class="bi bi-cart-plus"></i> Solicitud de compra
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Filtros + Tabla ── -->
            <div class="row m-0 pt-3 pb-3">
                <div class="col-12 mb-3 mb-lg-0">
                    <form id="formFiltrosSolicitudes" autocomplete="on">
                        <div class="filtros-panel">

                            <div class="filtros-titulo">
                                <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                                Filtros de búsqueda
                            </div>

                            <div class="row g-2 align-items-end">

                                <!-- Orden de Trabajo -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroOrdenTrabajo">
                                        <i class="bi bi-file-earmark-text-fill"></i> Orden de Trabajo
                                    </label>
                                    <input type="text" class="filtro-input"
                                           id="FiltroOrdenTrabajo" name="FiltroOrdenTrabajo"
                                           placeholder="Buscar OT...">
                                </div>

                                <!-- Fecha Inicio -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroFechaInicio">
                                        <i class="bi bi-calendar-check-fill"></i> Fecha Inicio
                                    </label>
                                    <input type="date" class="filtro-input"
                                           id="FiltroFechaInicio" name="FiltroFechaInicio">
                                </div>

                                <!-- Fecha Fin -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroFechaFin">
                                        <i class="bi bi-calendar-x-fill"></i> Fecha Fin
                                    </label>
                                    <input type="date" class="filtro-input"
                                           id="FiltroFechaFin" name="FiltroFechaFin">
                                </div>

                                <!-- Planta -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroPlanta">
                                        <i class="bi bi-building-fill"></i> Planta
                                    </label>
                                    <select class="filtro-input" id="FiltroPlanta" name="FiltroPlanta">
                                        <option value="">Todas las plantas...</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                    </select>
                                </div>

                                <!-- Nivel Urgencia -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroNivelUrgencia">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Urgencia
                                    </label>
                                    <select class="filtro-input" id="FiltroNivelUrgencia" name="FiltroNivelUrgencia">
                                        <option value="">Todas las urgencias...</option>
                                        <option value="Normal">🚦 Normal</option>
                                        <option value="Urgente">⚠️ Urgente</option>
                                        <option value="Critico">🚨 Crítico</option>
                                    </select>
                                </div>

                                <!-- Botones -->
                                <div class="col-12 col-sm-6 col-md-4 col-xl-auto d-flex align-items-end gap-2">
                                    <button type="button"
                                            class="btn-filtro-aplicar"
                                            id="btnAplicarFiltros"
                                            title="Aplicar filtros">
                                        <i class="bi bi-search"></i>
                                        Buscar
                                    </button>
                                    <button type="button"
                                            class="btn-filtro-limpiar"
                                            id="btnLimpiarFiltros"
                                            title="Limpiar filtros">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        Limpiar
                                    </button>
                                </div>

                            </div>
                        </div>
                    </form>

                    <!-- Tabla -->
                    <div class="table-responsive small table-responsive-custom" id="tablaSolicitudesContainer">
                        <table class="table table-striped table-sm CustomTableResponsive" id="tablaSolicitudesRefacciones">
                            <thead class="table-light text-center">
                                <tr>
                                    <th></th>
                                    <th><input type="checkbox" id="chkSelectAll" title="Seleccionar todos"></th>
                                    <th>Acciones</th>
                                    <th>Orden Trabajo</th>
                                    <th>Artículos</th>
                                    <th>Cantidad</th>
                                    <th>Atendidas</th>
                                    <th>Nivel Urgencia</th>
                                    <th>Fecha</th>
                                    <th>Estatus</th>
                                    <th>Solicitud Compra</th>
                                    <th>Usuario Solicita</th>
                                    <th>Usuario Atiende</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


<!-- ══════════════════════════════════════════════
     MODAL: NUEVA SOLICITUD DE REFACCIÓN
══════════════════════════════════════════════ -->
<div class="modal fade" id="solicitudRefaccionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-plus-circle-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalSolicitudTitulo">Nueva Solicitud de Refacción</div>
                        <div class="modal-subtitle-custom">Complete los datos para registrar la solicitud</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <form id="formSolicitudRefaccion" class="needs-validation" novalidate>
                    <input type="hidden" id="solicitudId">

                    <!-- Sección 1: Orden de Trabajo -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-file-earmark-text-fill me-2"></i>Orden de Trabajo
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="solicitudOT">
                                    <i class="bi bi-file-earmark-text"></i> Orden de Trabajo <span class="text-danger">*</span>
                                </label>
                                <select class="form-select-custom" id="solicitudOT" required>
                                    <option value="">Seleccionar OT...</option>
                                    <option value="OT-005">OT-005 - ENS-100</option>
                                    <option value="OT-008">OT-008 - MEZ-850</option>
                                    <option value="OT-012">OT-012 - HORNO-7G</option>
                                    <option value="OT-018">OT-018 - ML-2200</option>
                                    <option value="OT-022">OT-022 - CNC-789-XF</option>
                                    <option value="OT-025">OT-025 - ROB-6AX</option>
                                    <option value="OT-028">OT-028 - EMP-345</option>
                                </select>
                                <div class="modal-error-msg invalid-feedback">⚠️ Selecciona una orden de trabajo.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="solicitudEquipo">
                                    <i class="bi bi-gear-fill"></i> Equipo
                                </label>
                                <input type="text" class="form-control-custom" id="solicitudEquipo" readonly>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 2: Refacción -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-wrench-adjustable-circle-fill me-2"></i>Refacción
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label-custom" for="refaccionNombre">
                                    <i class="bi bi-tag-fill"></i> Nombre de la Refacción <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control-custom" id="refaccionNombre" required
                                       placeholder="Ej: Rodamiento axial 6008-2RS">
                                <div class="modal-error-msg invalid-feedback">⚠️ Ingresa el nombre de la refacción.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom" for="refaccionCantidad">
                                    <i class="bi bi-123"></i> Cantidad <span class="text-danger">*</span>
                                </label>
                                <input type="number" class="form-control-custom" id="refaccionCantidad" min="1" required>
                                <div class="modal-error-msg invalid-feedback">⚠️ Ingresa la cantidad.</div>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 3: Clasificación -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-sliders me-2"></i>Clasificación
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="refaccionUrgencia">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Nivel de Urgencia <span class="text-danger">*</span>
                                </label>
                                <select class="form-select-custom" id="refaccionUrgencia" required>
                                    <option value="">Seleccionar urgencia...</option>
                                    <option value="Normal">Normal</option>
                                    <option value="Urgente">Urgente</option>
                                    <option value="Crítico">Crítico</option>
                                </select>
                                <div class="modal-error-msg invalid-feedback">⚠️ Selecciona el nivel de urgencia.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="refaccionEstatus">
                                    <i class="bi bi-toggle-on"></i> Estatus <span class="text-danger">*</span>
                                </label>
                                <select class="form-select-custom" id="refaccionEstatus" required>
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Autorizado">Autorizado</option>
                                    <option value="Rechazado">Rechazado</option>
                                    <option value="En tránsito">En tránsito</option>
                                    <option value="Entregado">Entregado</option>
                                </select>
                                <div class="modal-error-msg invalid-feedback">⚠️ Selecciona el estatus.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label-custom" for="refaccionDescripcion">
                                    <i class="bi bi-card-text"></i> Descripción de la necesidad
                                </label>
                                <textarea class="form-control-custom" id="refaccionDescripcion" rows="3"
                                          placeholder="Describa por qué necesita esta refacción..."></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label-custom" for="refaccionComentarios">
                                    <i class="bi bi-chat-left-text-fill"></i> Comentarios adicionales
                                </label>
                                <textarea class="form-control-custom" id="refaccionComentarios" rows="2"
                                          placeholder="Comentarios adicionales..."></textarea>
                            </div>
                        </div>
                    </div>

                </form>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
                <button type="button" class="btn-modal-guardar" id="btnGuardarSolicitud">
                    <i class="bi bi-floppy-fill me-1"></i> Guardar
                </button>
            </div>

        </div>
    </div>
</div>


@Html.Partial("_ModalSolicitudCompra")


<!-- ══════════════════════════════════════════════
     MODAL: DEVOLUCIÓN DE MERCANCÍA
═════════════════════════════════════════════ -->
<div class="modal fade" id="devolucionMercancia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width:95%">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-arrow-return-left"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">Devolución de Mercancía</div>
                        <div class="modal-subtitle-custom">Seleccione los artículos a devolver</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="formDevolucionMercancia" class="needs-validation" novalidate>
                <div class="modal-body-custom">

                    <!-- Datos del solicitante -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label-custom" for="devolucionSolicitante">
                                <i class="bi bi-person-circle"></i> Solicitante <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control-custom" id="devolucionSolicitante" required>
                            <div class="modal-error-msg invalid-feedback">⚠️ Ingrese el nombre del solicitante.</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label-custom" for="devolucionNumEmpleado">
                                <i class="bi bi-person-vcard-fill"></i> # de Empleado <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control-custom" id="devolucionNumEmpleado" required>
                            <div class="modal-error-msg invalid-feedback">⚠️ Ingrese el número de empleado.</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label-custom" for="devolucionArea">
                                <i class="bi bi-columns-gap"></i> Área <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control-custom" id="devolucionArea" required>
                            <div class="modal-error-msg invalid-feedback">⚠️ Ingrese el área.</div>
                        </div>
                    </div>

                    <!-- Firmas -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label-custom" for="devolucionEntrega">
                                <i class="bi bi-person-lines-fill"></i> Almacenista (Entrega)<span class="text-danger">*</span>
                            </label>
                            <select class="form-select-custom" id="devolucionEntrega" required>
                                <option value="">Seleccionar...</option>
                            </select>
                            <div class="modal-error-msg invalid-feedback">⚠️ Seleccione quien entrega.</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label-custom" for="devolucionRecibe">
                                <i class="bi bi-person-check-fill"></i> Autorización (Recibe)<span class="text-danger">*</span>
                            </label>
                            <select class="form-select-custom" id="devolucionRecibe" required>
                                <option value="">Seleccionar...</option>
                            </select>
                            <div class="modal-error-msg invalid-feedback">⚠️ Seleccione quien recibe.</div>
                        </div>
                    </div>

                    <!-- Tabla de artículos a devolver -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-box-seam me-2"></i>Artículos a Devolver
                            <span class="badge bg-secondary ms-2" id="badgeTotalDevolucion">0</span>
                        </h6>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="chkSelAllDevolucion">
                                <label class="form-check-label small fw-semibold" for="chkSelAllDevolucion">Seleccionar todos</label>
                            </div>
                            <small class="text-muted">Artículos seleccionados: <strong id="contadorDevolucion">0</strong></small>
                        </div>
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px;">
                            <table class="table table-striped table-sm CustomTableResponsive" id="tablaArticulosDevolucion">
                                <thead class="table-light text-center position-sticky top-0" style="z-index: 1;">
                                    <tr>
                                        <th style="width: 40px;">#</th>
                                        <th style="width: 60px;"><i class="bi bi-clock-history me-1"></i>Historial</th>
                                        <th style="width: 40px;">
                                            <input type="checkbox" id="chkAllDevolucion" disabled>
                                        </th>
                                        <th>Orden Trabajo</th>
                                        <th>Código</th>
                                        <th>Artículo</th>
                                        <th style="width: 100px;">Cant. Solicitada</th>
                                        <th style="width: 100px;">Cant. Surtida</th>
                                        <th style="width: 130px;">Estatus</th>
                                        <th style="width: 100px;">
                                            Cant. a Devolver
                                            <span class="text-danger">*</span>
                                        </th>

                                        <th style="width: 100px;">DEPARTAMENTO</th>
                                        <th style="width: 100px;">PROCESO</th>
                                        <th style="width: 100px;">GASTOS</th>
                                        <th style="width: 100px;">CEDIS</th>
                                    </tr>
                                </thead>
                                <tbody id="bodyArticulosDevolucion">
                                    <tr>
                                        <td colspan="14" class="text-center text-muted py-4">
                                            <i class="bi bi-info-circle me-1"></i>Seleccione una solicitud para ver los artículos atendidos
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="alertDevolucionContainer" class="mt-2"></div>
                </div>

                <!-- ── Footer ── -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-guardar" id="btnGuardarDevolucion">
                        <i class="bi bi-floppy-fill me-1"></i> Guardar
                    </button>
                    <button type="button" class="btn-ptm btn-ptm-mid" id="btnRechazarDev">Rechazar</button>
                    <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- ══════════════════════════════════════════════
     MODAL: SALIDA DE MATERIALES
══════════════════════════════════════════════ -->
<div class="modal fade" id="salidaMercancia" tabindex="-1" aria-hidden="true" data-bs-keyboard="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width:95%">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="titleSalidaMercancia">Salida de Materiales</div>
                        <div class="modal-subtitle-custom">
                            Folio: <strong id="valeFolio" class="text-white"># 00010</strong>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="frmVale" class="needs-validation" novalidate autocomplete="on">
                <div class="modal-body-custom">

                    <!-- Sección 1: Datos de la Solicitud -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-file-earmark-text-fill me-2"></i>Datos de la Solicitud
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label-custom" for="fechaDia">
                                    <i class="bi bi-calendar2-range-fill"></i> Fecha
                                </label>
                                <input type="date" class="form-control-custom" id="fechaDia"
                                       name="Fecha dia" required readonly autocomplete="off">
                                <div class="modal-error-msg invalid-feedback">
                                    <img src="~/Content/Images/alerta.gif" width="24" class="me-3"> Por favor ingrese la fecha.
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom" for="numAjuste">
                                    <i class="bi bi-list-ol"></i> Número de Ajuste
                                </label>
                                <input type="text" class="form-control-custom" id="numAjuste"
                                       name="# de Ajuste" placeholder="# de Ajuste" required readonly autocomplete="off">
                                <div class="modal-error-msg invalid-feedback">
                                    <img src="~/Content/Images/alerta.gif" width="24" class="me-3"> Por favor ingrese el número de ajuste.
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 2: Datos del Solicitante -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-person-fill me-2"></i>Datos del Solicitante
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="solicitante">
                                    <i class="bi bi-person-circle"></i> Nombre del Solicitante <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control-custom" id="solicitante"
                                       name="solicitante" placeholder="Nombre del solicitante"
                                       required autocomplete="on">
                                <div class="modal-error-msg invalid-feedback">
                                    <img src="~/Content/Images/alerta.gif" width="24" class="me-3"> Por favor ingrese el nombre del solicitante.
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-custom" for="numEmpleado">
                                    <i class="bi bi-person-vcard-fill"></i> # de Empleado <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control-custom" id="numEmpleado"
                                       name="Numero Empleado" placeholder="Número de empleado"
                                       required autocomplete="on">
                                <div class="modal-error-msg invalid-feedback">
