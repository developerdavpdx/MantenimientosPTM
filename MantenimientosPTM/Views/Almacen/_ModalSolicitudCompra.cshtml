<!-- ══════════════════════════════════════════════
     MODAL: GENERAR SOLICITUD DE COMPRA
══════════════════════════════════════════════ -->
<div class="modal fade" id="solicitudCompra" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width:80%">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalSolicitudCompraTitulo">Generar Solicitud de Compra</div>
                        <div class="modal-subtitle-custom">Capture la cantidad a encargar por cada solicitud</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="formSolicitudCompra" class="needs-validation" novalidate>
                <div class="modal-body-custom">

                    <!-- Tabla de solicitudes seleccionadas -->
                    <div class="table-responsive mb-3">
                        <table class="table table-striped table-sm CustomTableResponsive" id="tablaSolicitudesSeleccionadas">
                            <thead class="table-light text-center">
                                <tr>
                                    <th style="width: 40px;">
                                        <input type="checkbox" id="chkSelectAllSC" title="Seleccionar todos">
                                    </th>
                                    <th>Orden de Trabajo</th>
                                    <th>Código Refacción</th>
                                    <th>Artículo</th>
                                    <th class="text-end">Stock</th>
                                    <th class="text-end">Min</th>
                                    <th class="text-end">Max</th>
                                    <th>Cant. Requerida</th>
                                    <th>Cant. a Encargar <span class="text-danger">*</span></th>
                                </tr>
                            </thead>
                            <tbody id="bodySeleccionadas">
                                <!-- Se llena dinámicamente -->
                            </tbody>
                        </table>
                    </div>

                    <div class="col-12">
                        <label class="form-label-custom" for="ComentariosSC">
                            <i class="bi bi-chat-left-text-fill"></i> Comentarios
                        </label>
                        <textarea class="form-control-custom" id="ComentariosSC" rows="3"
                                  placeholder="Comentarios adicionales..."></textarea>
                        <div class="modal-error-msg invalid-feedback">⚠️ Ingresa un comentario.</div>
                    </div>

                    <div id="alertSolicitudCompraContainer" class="mt-2"></div>
                </div>

                <!-- ── Footer ── -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn-modal-guardar" id="btnGuardarSC">
                        <i class="bi bi-floppy-fill me-1"></i> Guardar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>