@{
    ViewBag.Title = "Gestión de Equipos";
}

<link href="~/Content/GestionEquipos.css" rel="stylesheet" />

<!-- Tabla de equipos -->
<div class="row m-0 ps-3 pt-4 pe-3 main-container position-relative header-custom">
    <div class="col-12 col-xl-12 p-0">
        <div class="card shadow">
            <div class="card-header header-fijo-custom text-dark">
                <div class="row g-2 align-items-center mb-3">
                    <!-- Título -->
                    <div class="col-12 col-lg-4">
                        <h4 class="mb-0 text-color-logo">
                            <i class="bi bi-gear-wide-connected me-2"></i>Equipos De Mantenimiento
                        </h4>
                    </div>
                    <!-- Botones -->
                    <div class="col-12 col-lg-8">
                        <div class="d-flex flex-wrap justify-content-start justify-content-lg-end gap-2">
                            <a href="#" id="AgregarEquipo" class="btn-filtro-aplicar" title="Agregar Nuevo Equipo">
                                <i class="bi bi-plus-circle-fill me-1"></i>Agregar Equipo
                            </a>
                            <a href="#" id="GestionarLineas" class="btn-filtro-limpiar" title="Gestionar Líneas">
                                <i class="bi bi-diagram-3-fill me-1"></i>Gestionar Líneas
                            </a>
                            <a href="#" id="AgregarTipoEquipo" class="btn-filtro-limpiar" title="Agregar Nuevo Tipo de Equipo">
                                <i class="bi bi-shield-lock me-1"></i>Gestionar Tipos Equipo
                            </a>
                            <a href="#" id="GestionarAreas" class="btn-filtro-limpiar" title="Gestionar Áreas">
                                <i class="bi bi-diagram-3-fill me-1"></i>Gestionar Áreas
                            </a>
                            <a href="#" id="btnExportarExcel" class="btn-filtro-limpiar d-flex align-items-center" title="Exportar Equipos">
                                <i class="bi bi-file-earmark-excel-fill me-1"></i>Exportar Equipos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="filtros-panel">

                    <div class="filtros-titulo">
                        <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                        Filtros de búsqueda
                    </div>

                    <div class="row g-2 align-items-end">

                        <!-- Proceso -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroProceso">
                                <i class="bi bi-gear-fill"></i> Proceso
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroProceso" name="FiltroProceso">
                                    <option value="">Todos los procesos...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroProceso">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Línea de Producción -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroLinea">
                                <i class="bi bi-diagram-3-fill"></i> Línea de Producción
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroLinea" name="FiltroLinea" disabled>
                                    <option value="">Todas las líneas...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroLinea">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>


                        <!-- Orden de Trabajo -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroOrdenTrabajo">
                                <i class="bi bi-file-earmark-text-fill"></i> Orden de Trabajo
                            </label>
                            <input type="text" class="filtro-input"
                                   id="FiltroOrdenTrabajo" name="FiltroOrdenTrabajo"
                                   placeholder="Buscar por orden...">
                        </div>

                        <!-- Fecha Inicio Mantenimiento -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroFechaInicioMantenimiento">
                                <i class="bi bi-calendar-check-fill"></i> Fecha Inicio Mantenimiento
                            </label>
                            <input type="date" class="filtro-input"
                                   id="FiltroFechaInicioMantenimiento"
                                   name="FiltroFechaInicioMantenimiento">
                        </div>

                        <!-- Filtro Estatus -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label-custom" for="FiltroEstatus">
                                <i class="bi bi-circle-fill"></i> Estatus <span class="text-danger"></span>
                            </label>
                            <select class="form-select-custom" id="FiltroEstatus" required autocomplete="off">
                                <option value="1,2,3,4">Todos los estatus...</option>
                                <option value="1" selected>Activo</option>
                                <option value="2">Inactivo</option>
                            </select>
                        </div>

                        <!-- Botones -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-auto d-flex align-items-end gap-2">
                            <button type="button" class="btn-filtro-aplicar"
                                    id="btnAplicarFiltros" title="Aplicar filtros">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>
                            <button type="button" class="btn-filtro-limpiar"
                                    id="btnLimpiarFiltros" title="Limpiar filtros">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Limpiar
                            </button>
                        </div>

                    </div>
                </div>
                <div class="table-responsive small table-responsive-custom" id="tablaEquiposContainer">
                    <table class="table table-striped table-sm CustomTableResponsive" id="tablaEquipos">
                        <thead>
                            <tr>
                                <th></th> <!-- 👈 NUEVO: Columna vacía para el control +/- -->
                                <th scope="col" class="col-actions">Acciones</th>
                                <th scope="col">Planta</th>
                                <th scope="col">Proceso</th>
                                <th scope="col">Línea</th>
                                <th scope="col">Equipo</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Centro Costos</th>
                                <th scope="col">Doc Pm.Calidad</th>
                                <th scope="col">Fecha inicial mantenimiento</th>
                                <th scope="col">Periodicidad MP</th>
                                <th scope="col">Estatus</th>
                                <th scope="col">Comentarios Pausa</th>
                                <th scope="col">Fecha de Pausa</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_ModalAgregarEditarEquipos")

@Html.Partial("_ModalPausarEquipo")

@Html.Partial("_ModalAgregarTipoEquipo")

@Html.Partial("_ModalGestionAreas")

@Html.Partial("_ModalSolicitudBajaEquipo")

@Html.Partial("_ModalRutinaMantenimiento")

@Html.Partial("_ModalVerImagenAmpliada")

@Html.Partial("_ModalGestionLineasProduccion")

<!-- El contenido de gestión de líneas se ha integrado dentro del modal principal #lineaModal (pestañas Listar/Alta) -->
<!-- Loader fullscreen -->
<div id="calendarLoader" style="display: none;">
    <div class="calendar-loader-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-white fw-semibold" id="loading_description">Cargando equipos por favor espere...</p>
    </div>
</div>
<!-- Container para alerts de Bootstrap -->
<script src="~/Scripts/gestion_equipos_refactor.js?v1.0.0"></script>
<script src="~/Scripts/FileUpload.js"></script>
