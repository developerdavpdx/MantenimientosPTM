@{
    ViewBag.Title = "Gestión de Equipos";
}

<!-- Tabla de equipos -->
<div class="row m-0 ps-3 pt-4 pe-3 main-container position-relative header-custom">
    <div class="col-12 col-xl-12 p-0">
        <div class="card shadow">
            <div class="card-header header-fijo-custom text-dark">
                <div class="row g-2 align-items-center mb-3">
                    <!-- Título -->
                    <div class="col-12 col-lg-4">
                        <h4 class="mb-0 text-color-logo">
                            <i class="bi bi-gear-wide-connected me-2"></i>Equipos De Mantenimiento
                        </h4>
                    </div>
                    <!-- Botones -->
                    <div class="col-12 col-lg-8">
                        <div class="d-flex flex-wrap justify-content-start justify-content-lg-end gap-2">
                            <a href="#" id="AgregarEquipo" class="btn-filtro-aplicar" title="Agregar Nuevo Equipo">
                                <i class="bi bi-plus-circle-fill me-1"></i>Agregar Equipo
                            </a>
                            <a href="#" id="AgregarLinea" class="btn-filtro-limpiar" title="Agregar Nueva Línea">
                                <i class="bi bi-diagram-3-fill me-1"></i>Agregar Línea
                            </a>
                            <a href="#" id="AgregarTipoEquipo" class="btn-filtro-limpiar" title="Agregar Nuevo Tipo de Equipo">
                                <i class="bi bi-shield-lock me-1"></i>Agregar Tipo Equipo
                            </a>
                            <a href="#" id="btnExportarExcel" class="btn-filtro-limpiar d-flex align-items-center" title="Exportar Equipos">
                                <i class="bi bi-file-earmark-excel-fill me-1"></i>Exportar Equipos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="filtros-panel">

                    <div class="filtros-titulo">
                        <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                        Filtros de búsqueda
                    </div>

                    <div class="row g-2 align-items-end">

                        <!-- Proceso -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroProceso">
                                <i class="bi bi-gear-fill"></i> Proceso
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroProceso" name="FiltroProceso">
                                    <option value="">Todos los procesos...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroProceso">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Línea de Producción -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroLinea">
                                <i class="bi bi-diagram-3-fill"></i> Línea de Producción
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroLinea" name="FiltroLinea" disabled>
                                    <option value="">Todas las líneas...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroLinea">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>


                        <!-- Orden de Trabajo -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroOrdenTrabajo">
                                <i class="bi bi-file-earmark-text-fill"></i> Orden de Trabajo
                            </label>
                            <input type="text" class="filtro-input"
                                   id="FiltroOrdenTrabajo" name="FiltroOrdenTrabajo"
                                   placeholder="Buscar por orden...">
                        </div>

                        <!-- Fecha Inicio Mantenimiento -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="filtro-label" for="FiltroFechaInicioMantenimiento">
                                <i class="bi bi-calendar-check-fill"></i> Fecha Inicio Mantenimiento
                            </label>
                            <input type="date" class="filtro-input"
                                   id="FiltroFechaInicioMantenimiento"
                                   name="FiltroFechaInicioMantenimiento">
                        </div>

                        <!-- Filtro Estatus -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label-custom" for="FiltroEstatus">
                                <i class="bi bi-circle-fill"></i> Estatus <span class="text-danger"></span>
                            </label>
                            <select class="form-select-custom" id="FiltroEstatus" required autocomplete="off">
                                <option value="1,2,3,4">Todos los estatus...</option>
                                <option value="1" selected>Activo</option>
                                <option value="2">Inactivo</option>
                            </select>
                        </div>

                        <!-- Botones -->
                        <div class="col-12 col-sm-6 col-md-4 col-xl-auto d-flex align-items-end gap-2">
                            <button type="button" class="btn-filtro-aplicar"
                                    id="btnAplicarFiltros" title="Aplicar filtros">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>
                            <button type="button" class="btn-filtro-limpiar"
                                    id="btnLimpiarFiltros" title="Limpiar filtros">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Limpiar
                            </button>
                        </div>

                    </div>
                </div>
                <div class="table-responsive small table-responsive-custom" id="tablaEquiposContainer">
                    <table class="table table-striped table-sm CustomTableResponsive" id="tablaEquipos">
                        <thead>
                            <tr>
                                <th></th> <!-- 👈 NUEVO: Columna vacía para el control +/- -->
                                <th scope="col" class="col-actions">Acciones</th>
                                <th scope="col">Planta</th>
                                <th scope="col">Proceso</th>
                                <th scope="col">Línea</th>
                                <th scope="col">Equipo</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Centro Costos</th>
                                <th scope="col">Doc Pm.Calidad</th>
                                <th scope="col">Fecha inicial mantenimiento</th>
                                <th scope="col">Periodicidad MP</th>
                                <th scope="col">Estatus</th>
                                <th scope="col">Comentarios Pausa</th>
                                <th scope="col">Fecha de Pausa</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- ══════════════════════════════════════════════
     MODAL AGREGAR / EDITAR EQUIPO
══════════════════════════════════════════════ -->
<div class="modal fade" id="equipoModal" tabindex="-1" aria-hidden="true" data-bs-keyboard="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="max-width:95%">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalEquipoTitulo">Agregar Nuevo Equipo</div>
                        <div class="modal-subtitle-custom">Complete los datos para registrar el equipo</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="formEquipo" class="needs-validation" novalidate autocomplete="on">
                <div class="modal-body-custom">
                    <input type="hidden" id="IdEquipo" name="IdEquipo" autocomplete="off">

                    <!-- Sección 1: Información General -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-info-circle-fill me-2"></i>Información General
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="Planta">
                                    <i class="bi bi-building"></i> Planta
                                </label>
                                <input type="text" class="form-control-custom" id="Planta" name="Planta" readonly autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="TipoEquipo">
                                    <i class="bi bi-tools"></i> Tipo Equipo
                                </label>
                                <select class="form-select-custom" id="TipoEquipo" name="TipoEquipo" required autocomplete="off">
                                    <option value="">Seleccionar tipo...</option>
                                </select>
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Por favor seleccione un tipo de equipo.</div>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 2: Detalles del Equipo -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-card-text me-2"></i>Detalles del Equipo
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="NombreEquipo">
                                    <i class="bi bi-tag"></i> Nombre de Equipo
                                </label>
                                <input type="text" class="form-control-custom" id="NombreEquipo" name="NombreEquipo"
                                       placeholder="Ingrese nombre de equipo" required autocomplete="on">
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  El nombre del equipo es obligatorio.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="DescripcionEquipo">
                                    <i class="bi bi-card-heading"></i> Descripción de Equipo
                                </label>
                                <input type="text" class="form-control-custom" id="DescripcionEquipo" name="DescripcionEquipo"
                                       placeholder="Ingrese la descripción de equipo" required autocomplete="on">
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  La descripción del equipo es obligatoria.</div>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 3: Ubicación y Organización -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-geo-alt-fill me-2"></i>Ubicación y Organización
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="Area">
                                    <i class="bi bi-diagram-3"></i> Área
                                </label>
                                <select class="form-select-custom" id="Area" name="Area" required autocomplete="off">
                                    <option value="">Seleccionar área...</option>
                                </select>
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Por favor seleccione un área.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="LineaProduccion">
                                    <i class="bi bi-arrow-repeat"></i> Línea de Producción
                                </label>
                                <div class="select-wrapper">
                                    <select class="filtro-input" id="LineaProduccion" name="LineaProduccion" required disabled autocomplete="off">
                                        <option value="">Todas las líneas...</option>
                                    </select>
                                    <div class="select-loader d-none" id="loader_LineaProduccion">
                                        <span class="spinner-border spinner-border-sm"></span>
                                    </div>
                                    <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Por favor seleccione una línea de producción.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 4: Información Administrativa -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-file-text-fill me-2"></i>Información Administrativa
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="CentroCostos">
                                    <i class="bi bi-cash-coin"></i> Centro de Costos
                                </label>
                                <input type="text" class="form-control-custom" id="CentroCostos" name="CentroCostos"
                                       placeholder="Ingrese centro de costos" required autocomplete="on">
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  El centro de costos es obligatorio.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" for="NumeroDocPmCalidad">
                                    <i class="bi bi-file-earmark-check"></i> Número de Doc PM Calidad
                                </label>
                                <input type="text" class="form-control-custom" id="NumeroDocPmCalidad" name="NumeroDocPmCalidad"
                                       placeholder="Número de doc pm.calidad" required autocomplete="on">
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  El número de documento es obligatorio.</div>
                            </div>
                        </div>
                    </div>

                    <hr class="divider-custom">

                    <!-- Sección 5: Configuración de Mantenimiento -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-calendar-check-fill me-2"></i>Configuración de Mantenimiento
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom" for="PeriodicidadMantenimiento">
                                    <i class="bi bi-arrow-clockwise"></i> Periodicidad de Mantenimiento
                                </label>
                                <select class="form-select-custom" id="PeriodicidadMantenimiento" name="PeriodicidadMantenimiento" required autocomplete="off">
                                    <option value="">Seleccionar periodicidad...</option>
                                    @*<option value="mensual">Mensual</option>
                                        <option value="bimestral">Bimestral</option>
                                        <option value="trimestral">Trimestral</option>
                                        <option value="cuatrimestral">Cuatrimestral</option>
                                        <option value="quinquemestre">Quinquemestre</option>
                                        <option value="semestral">Semestral</option>
                                        <option value="anual">Anual</option>*@
                                </select>
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Por favor seleccione la periodicidad.</div>
                            </div>

                            <div class="col-md-6" id="divRangoMantenimiento">
                                <label class="form-label-custom">
                                    <i class="bi bi-calendar-range"></i> Rango de Días para Mantenimiento
                                </label>
                                <div class="d-flex gap-2">
                                    <div class="flex-fill">
                                        <select class="form-select-custom" id="DiaInicioMant" name="DiaInicioMant" required autocomplete="off">
                                            <option value="">Día inicio</option>
                                        </select>
                                        <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Seleccione día inicial.</div>
                                    </div>
                                    <div class="flex-fill">
                                        <select class="form-select-custom" id="DiaFinMant" name="DiaFinMant" required autocomplete="off">
                                            <option value="">Día fin</option>
                                        </select>
                                        <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Seleccione día final.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6" id="divFechaInicioMantenimiento">
                                <label class="form-label-custom" for="FechaInicioMant">
                                    <i class="bi bi-calendar-plus"></i> Fecha Inicio Mantenimiento
                                </label>
                                <input type="date" class="form-control-custom" id="FechaInicioMant" name="FechaInicioMant" required autocomplete="off">
                                <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Seleccione la fecha de inicio del mantenimiento.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Alerta Container -->
                    <div class="row">
                        <div class="col-md-12">
                            <div id="alertEquipoContainer"></div>
                        </div>
                    </div>

                    <!-- Campos ocultos -->
                    <div class="col-12 d-none">
                        <input type="text" class="form-control-custom" id="Estatus" name="Estatus" value="1" readonly autocomplete="off">
                    </div>
                    <div class="col-12 d-none">
                        <textarea class="form-control-custom" id="Comentarios" name="Comentarios" rows="2" readonly autocomplete="off"></textarea>
                    </div>

                </div>

                <!-- ── Footer ── -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn-modal-guardar" id="btnGuardarEquipo">
                        <i class="bi bi-floppy-fill me-1"></i> Guardar Equipo
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL PAUSAR EQUIPO
══════════════════════════════════════════════ -->
<div class="modal fade" id="modalPausarEquipo" tabindex="-1" aria-labelledby="modalPausarEquipoLabel" aria-hidden="true" data-bs-keyboard="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-pause-circle-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalPausarEquipoLabel">Pausar Equipo</div>
                        <div class="modal-subtitle-custom">Indique el motivo de la pausa del equipo</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="formPausaEquipo" class="needs-validation" novalidate autocomplete="on">
                <div class="modal-body-custom">

                    <!-- Información del Equipo -->
                    <div class="mb-3">
                        <h6 class="mb-3 pb-2 border-bottom" style="color: var(--modal-primary); font-weight:700;">
                            <i class="bi bi-info-circle-fill me-2"></i>Información del Equipo
                        </h6>

                        <!-- Banner equipo a pausar -->
                        <div class="modal-banner-info">
                            <i class="bi bi-gear-fill" style="font-size:1.2rem; flex-shrink:0;"></i>
                            <div>
                                <small class="d-block" style="opacity:0.75;">Equipo a pausar:</small>
                                <strong id="nombreEquipoPausar" class="fs-6">-</strong>
                            </div>
                        </div>

                        <!-- Razón de la Pausa -->
                        <div class="col-12">
                            <label class="form-label-custom" for="ComentariosPausa">
                                <i class="bi bi-chat-square-text-fill"></i> Razón de la Pausa
                            </label>
                            <textarea id="ComentariosPausa" name="ComentariosPausa"
                                      class="form-control-custom"
                                      rows="4"
                                      placeholder="Describe el motivo de la pausa del equipo..."
                                      required autocomplete="off"></textarea>
                            <div class="modal-error-msg invalid-feedback"><img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Describa el motivo de pausa.</div>
                            <div class="mt-1" style="font-size:0.78rem; color: var(--modal-text-muted);">
                                <i class="bi bi-lightbulb text-warning"></i> Ejemplo: Falla mecánica, mantenimiento preventivo, etc.
                            </div>
                        </div>

                        <!-- Alerta Container -->
                        <div class="row pt-3 g-3">
                            <div class="col-12">
                                <div id="alertPauseEquipoContainer"></div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ── Footer ── -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn-modal-guardar danger" id="btnConfirmarPausa">
                        <i class="bi bi-pause-circle-fill me-1"></i> Pausar Equipo
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL AGREGAR TIPO EQUIPO
══════════════════════════════════════════════ -->
<div class="modal fade" id="modalAgregarTipoEquipo" tabindex="-1" aria-labelledby="modalAgregarTipoEquipoLabel" aria-hidden="true" data-bs-keyboard="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap success">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalAgregarTipoEquipoLabel">
                            Agregar Tipo de Equipo
                        </div>
                        <div class="modal-subtitle-custom">
                            Registre un nuevo tipo de equipo
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="formAgregarTipoEquipo" class="needs-validation" novalidate autocomplete="off">
                <div class="modal-body-custom">

                    <!-- Información -->
                    <div class="mb-3">
                        <!-- Tipo de Equipo -->
                        <div class="col-12 mb-3">
                            <label class="form-label-custom" for="NombreTipoEquipo">
                                <i class="bi bi-tag-fill"></i>
                                Nombre del Tipo de Equipo
                            </label>

                            <input type="text"
                                   id="NombreTipoEquipo"
                                   name="NombreTipoEquipo"
                                   class="form-control-custom"
                                   placeholder="Ejemplo: Extrusoras, Recibidores..."
                                   required />

                            <div class="modal-error-msg invalid-feedback">
                                <img src="~/Content/Images/alerta.gif" width="24" class"me-3">  Ingrese el tipo de equipo.
                            </div>

                            <div class="mt-1" style="font-size:0.78rem; color: var(--modal-text-muted);">
                                <i class="bi bi-lightbulb text-warning"></i>
                                Ejemplo: Extrusoras, Tanques, Impresoras, etc.
                            </div>
                        </div>


                        <!-- Alert Container -->
                        <div class="row pt-3 g-3">
                            <div class="col-12">
                                <div id="alertTipoEquipoContainer"></div>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- ── Footer ── -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
