@{
    ViewBag.Title = "Producción Corrugado";
}

<link href="~/Content/Produccion.css" rel="stylesheet" />
<link href="~/Content/TiemposMuertos.css" rel="stylesheet" />

<main aria-labelledby="title">
    <div class="ps-2 pe-2 pt-3 pb-3">
        <div class="row m-0 pt-3">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header text-dark">
                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-md-8">
                                <h4 class="mb-0 text-color-logo d-flex">
                                    <i class="bi bi-table me-2"></i>Causas Tiempos Muertos
                                    <span id="fechaActual" class="text-primary ms-2">Corrugado</span>
                                    <span id="mesActual" class="text-primary ms-2"></span>
                                </h4>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="d-flex justify-content-md-end gap-2">
                                    <button id="btnGuardarCambios" class="btn-filtro-aplicar">
                                        <i class="bi bi-save-fill me-1"></i>Guardar
                                    </button>
                                    <button id="btnExportarExcel" class="btn-filtro-limpiar">
                                        <i class="bi bi-file-excel-fill me-1"></i>Exportar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">

                        <!-- FILTROS -->
                        <div class="filtros-panel">

                            <div class="filtros-titulo">
                                <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                                Filtros de búsqueda
                            </div>

                            <div class="row g-2 align-items-end">

                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label">
                                        <i class="bi bi-calendar-check-fill"></i> Fecha Inicio
                                    </label>
                                    <input type="date"
                                           class="filtro-input"
                                           id="FiltroFechaInicio">
                                </div>

                                <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label">
                                        <i class="bi bi-calendar-x-fill"></i> Fecha Fin
                                    </label>
                                    <input type="date"
                                           class="filtro-input"
                                           id="FiltroFechaFin">
                                </div>

                                <div class="col-auto d-flex gap-2">
                                    <button id="btnAplicarFiltros"
                                            class="btn-filtro-aplicar">
                                        <i class="bi bi-search"></i>
                                        Buscar
                                    </button>

                                    <button id="btnLimpiarFiltros"
                                            class="btn-filtro-limpiar">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        Limpiar
                                    </button>
                                </div>

                            </div>

                        </div>

                        <!-- GRID -->
                        <div id="tablaProduccion"
                             class="ag-theme-alpine d-none"></div>

                    </div>

                </div>

                <!-- Menu Contextual -->
                <div id="menuContextual" class="menu-contextual">
                    <div data-action="agregar">➕ Agregar fila</div>
                    <div data-action="copiar">📋 Copiar fila</div>
                    <div data-action="eliminar">🗑️ Eliminar fila</div>
                </div>

            </div>
        </div>
    </div>
</main>

<!-- Loader fullscreen -->
<div id="calendarLoader" style="display: none;">
    <div class="calendar-loader-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-white fw-semibold">Cargando datos por favor espere...</p>
    </div>
</div>

<script src="~/Scripts/produccion_corrugado_refactor.js"></script>