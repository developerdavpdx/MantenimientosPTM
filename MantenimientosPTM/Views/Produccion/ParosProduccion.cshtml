                <!-- 📋 TABLA DE PAROS -->
                <div id="tablaParosContainer" class="table-responsive small table-responsive-custom">
                    <table class="table table-striped table-sm CustomTableResponsive" id="HistorialParos">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <!-- 🆕 Planta -->
                                <th scope="col">
                                    <i class="bi bi-diagram-3-fill me-1"></i>Planta
                                </th>
                                <!-- 🆕 Linea -->
                                <th scope="col">
                                    <i class="bi bi-diagram-3-fill me-1"></i>Línea
                                </th>
                                <!-- 🆕 Categoría -->
                                <th scope="col">
                                    <i class="bi bi-tag-fill me-1"></i>Categoría
                                </th>
