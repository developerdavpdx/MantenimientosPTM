<!-- ══════════════════════════════════════════════
     MODAL REGISTRAR PARO DE PRODUCCIÓN
══════════════════════════════════════════════ -->
<div class="modal fade" id="modalRegistrarParo" tabindex="-1" aria-labelledby="modalRegistrarParoLabel" aria-hidden="true" data-bs-keyboard="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-pause-circle-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalRegistrarParoLabel">Registrar Paro de Producción</div>
                        <div class="modal-subtitle-custom">Complete los datos del paro ocurrido</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <form id="formRegistrarParo" class="needs-validation" novalidate>
                <div class="modal-body-custom">

                    <!-- Banner advertencia -->
                    <div class="modal-banner-info">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size:1rem; flex-shrink:0;"></i>
                        <span>Los paros registrados impactan directamente el reporte de producción.</span>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="filtro-label" for="FiltroPlantaParo">
                                <i class="bi bi-gear-fill"></i> Planta
                            </label>
                            <select class="filtro-input" id="FiltroPlantaParo" name="FiltroPlantaParo">
                                <option value="" selected>Todas las plantas...</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="filtro-label" for="FiltroProcesoParo">
                                <i class="bi bi-diagram-3-fill"></i> Área
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroProcesoParo" name="FiltroProcesoParo">
                                    <option value="">Todos los procesos...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroProcesoParo">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex justify-content-start align-items-end">
                            <button type="button" class="btn-filtro-aplicar"
                                    id="btnAplicarFiltrosParo" title="Aplicar filtros">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="filtro-label" for="ParoCategoria">
                                <i class="bi bi-diagram-3-fill"></i> Categoría
                            </label>
                            <select class="filtro-input" id="ParoCategoria" name="ParoCategoria">
                                <option value="">Todas las categorías...</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex justify-content-start align-items-end">
                            <button type="button" class="btn btn-sm btn-primary mt-2" id="btnAgregarParo">
                                <i class="bi bi-plus-circle"></i> Agregar Paros
                            </button>
                        </div>
                    </div>
                    <div id="LineasProduccionContainer" class="row mb-3 d-none">
                        <div class="col-md-12">
                            <label class="form-label-custom">
                                <i class="bi bi-diagram-3-fill"></i> Líneas de Producción
                            </label>

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="checkTodasLineas">
                                <label class="form-check-label fw-semibold" for="checkTodasLineas">
                                    Seleccionar todas las líneas
                                </label>
                            </div>

                            <div id="contenedorLineasParo" class="checkbox-group-custom row"></div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">

                            <div class="table-responsive small table-responsive-custom"
                                 id="tablaParosContainer"
                                 style="overflow-x:auto;">

                                <table class="table table-striped table-sm CustomTableResponsive"
                                       id="tablaParos"
                                       style="width:max(100%, 1000px);">
                                    <thead>
                                        <tr>
                                            <th>Línea</th>
                                            <th>Categoría</th>
                                            <th>Artículo</th>
                                            <th>Duración (hrs)</th>
                                            <th>Comentarios</th>
                                            <th style="width:50px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>

                    <!-- Alerta Container -->
                    <div class="row">
                        <div class="col-md-12">
                            <div id="alertParoContainer"></div>
                        </div>
                    </div>

                </div>

                <!-- ── Footer ── -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn-modal-guardar" id="btnGuardarParo">
                        <i class="bi bi-floppy-fill"></i> Guardar Paro
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL AGREGAR TIPO PARO
════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalAgregarTipoParo" tabindex="-1" aria-labelledby="modalAgregarTipoParoLabel" aria-hidden="true" data-bs-keyboard="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content">
            <!-- ── Header ── -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-plus-circle-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="modalAgregarTipoParoLabel">Agregar Categoría de Paro</div>
                        <div class="modal-subtitle-custom">Ingrese el nombre de la nueva categoría</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- ── Body ── -->
            <div class="modal-body-custom">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="filtro-label" for="lblPlantaTipoParo">
                            <i class="bi bi-building-fill"></i> Planta
                        </label>
                        <div class="filtro-input bg-light" id="lblPlantaTipoParo" style="padding: 0.5rem; border-radius: 0.375rem;"></div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="filtro-label" for="inputNombreTipoParo">
                            <i class="bi bi-tag-fill"></i> Nombre de Categoría
                        </label>
                        <input type="text" class="filtro-input" id="inputNombreTipoParo" 
                               maxlength="50" placeholder="Ingrese el nombre de la categoría" required>
                        <div class="form-text">Máximo 50 caracteres</div>
                    </div>
                </div>
                <!-- Alerta Container -->
                <div id="alertTipoParoContainer"></div>
            </div>

            <!-- ── Footer ── -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
                <button type="button" class="btn-modal-guardar" id="btnGuardarTipoParo">
                    <i class="bi bi-floppy-fill"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL REANUDAR PARO
══════════════════════════════════════════════ -->
<div class="modal fade" id="modalReanudarParo" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-play-circle-fill"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom">
                            Reanudar Producción
                        </div>
                        <div class="modal-subtitle-custom">
                            Confirmar reanudación del paro
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="btn-close-custom"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body-custom">

                <input type="hidden" id="ReanudarParoId" />

                <div class="modal-banner-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>
                        Se registrará la reanudación de producción.
                    </span>
                </div>

                <div class="mb-2">
                    <label class="form-label-custom">
                        <i class="bi bi-chat-left-text-fill"></i>
                        Comentarios (Opcional)
                    </label>

                    <textarea class="form-control-custom"
                              id="ReanudarComentarios"
                              maxlength="500"
                              placeholder="Ej: Falla corregida, producción restablecida...">
                    </textarea>
                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer-custom">

                <button type="button"
                        class="btn-modal-cancelar"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn-modal-guardar"
                        id="btnConfirmarReanudar">
                    <i class="bi bi-play-fill"></i>
                    Reanudar Producción
                </button>

            </div>

        </div>
    </div>
</div>

<!-- Modal para agregar datos de produccion -->
<div class="modal fade" id="addEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info-ptm text-white">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle-fill me-2"></i>Información de producción
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="eventForm" class="needs-validation" novalidate>
                    <div class="bg-white p-3 rounded shadow-sm border">
                        <div class="row g-3">
                            <div class="col-6">
                                <label for="LineaProduccion" class="form-label fw-semibold">
                                    <i class="bi bi-diagram-3 me-1 text-muted"></i>Línea de Producción
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-diagram-3-fill"></i>
                                    </span>
                                    <select class="form-select" id="LineaProduccion" name="LineaProduccion" required>
                                        <option value="">Todas las líneas...</option>
                                        <!-- Aquí cargas tus opciones dinámicamente -->
                                    </select>
                                    <div class="invalid-feedback">
                                        ⚠️ Seleccione la línea de producción.
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <label for="Fecha" class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event me-1 text-muted"></i>Fecha
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-calendar-event"></i>
                                    </span>
                                    <input type="date" class="form-control" id="Fecha" name="Fecha" required autocomplete="off">
                                    <div class="invalid-feedback">
                                        ⚠️ Seleccione la fecha.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 mt-2">
                            <div class="col-6">
                                <label for="Turno" class="form-label fw-semibold">
                                    <i class="bi bi-clock-history me-1 text-muted"></i>Turno
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-clock-fill"></i>
                                    </span>
                                    <select class="form-select" id="Turno" name="Turno" required>
                                        <option value="">Seleccione turno...</option>
                                        <!-- Aquí cargas tus opciones dinámicamente -->
                                    </select>
                                    <div class="invalid-feedback">
                                        ⚠️ Seleccione el turno.
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <label for="TotalTubos" class="form-label fw-semibold">
                                    <i class="bi bi-stack me-1 text-muted"></i>Total de tubos
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
