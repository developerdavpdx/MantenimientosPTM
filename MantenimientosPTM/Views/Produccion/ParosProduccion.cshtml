@{
    ViewBag.Title = "Gestión de Paros de Producción";
}

<link href="~/Content/TiemposMuertos.css" rel="stylesheet" />
<link href="~/Content/ParosProduccion.css" rel="stylesheet" />


<div class="row m-0 main-container position-relative header-custom">
    <div class="col-12">
        <div class="card shadow">
            <!-- HEADER DEL CARD -->
            <div class="card-header header-fijo-custom text-dark">
                <div class="row g-3 align-items-center">
                    <!-- Título -->
                    <div class="col-12 col-md-6">
                        <h4 class="mb-0 text-color-logo">
                            <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Reporte de Paros de Producción
                        </h4>
                    </div>

                    <!-- Botones de acción -->
                    <div class="col-12 col-md-6">
                        <div class="d-flex flex-column flex-sm-row justify-content-md-end gap-2">
                            <a href="#"
                               id="AddTipoParo"
                               class="btn-filtro-aplicar"
                               title="Agregar Tipo Paro">
                                <i class="bi bi-plus-circle-fill me-1"></i>
                                <span class="d-none d-sm-inline">Agregar Tipo </span>Paro
                            </a>
                            <a href="#"
                               id="RegistrarParo"
                               class="btn-filtro-aplicar"
                               title="Registrar Paro de Producción">
                                <i class="bi bi-pause-circle-fill me-1"></i>
                                <span class="d-none d-sm-inline">Registrar </span>Paro
                            </a>
                            <button type="button" class="btn-filtro-limpiar" id="btnExportarParos" title="Exportar reporte">
                                <i class="bi bi-file-earmark-excel-fill me-1"></i>
                                <span class="d-none d-sm-inline">Exportar</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BODY DEL CARD CON FILTROS -->
            <div class="card-body">
                <div class="filtros-panel">

                    <div class="filtros-titulo">
                        <i class="bi bi-sliders"></i>
                        Filtros de búsqueda
                    </div>

                    <div class="row g-2 align-items-end">
                        <!-- Planta -->
                        <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                            <label class="filtro-label" for="FiltroPlanta">
                                <i class="bi bi-gear-fill"></i> Planta
                            </label>
                            <select class="filtro-input" id="FiltroPlanta" name="FiltroPlanta">
                                <option value="">Todas las plantas...</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                            </select>
                        </div>
                        <!-- Proceso -->
                        <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                            <label class="filtro-label" for="FiltroProceso">
                                <i class="bi bi-gear-fill"></i> Proceso
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroProceso" name="FiltroProceso">
                                    <option value="">Todos los procesos...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroProceso">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Línea de Producción -->
                        <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                            <label class="filtro-label" for="FiltroLinea">
                                <i class="bi bi-diagram-3-fill"></i> Línea
                            </label>
                            <div class="select-wrapper">
                                <select class="filtro-input" id="FiltroLinea" name="FiltroLinea" disabled>
                                    <option value="">Todas las líneas...</option>
                                </select>
                                <div class="select-loader d-none" id="loader_FiltroLinea">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Estado -->
                        @*<div class="col-12 col-sm-6 col-md-3 col-xl-2">
            <label class="filtro-label" for="FiltroEstadoParo">
                <i class="bi bi-toggle-on"></i> Estado
            </label>
            <select class="filtro-input" id="FiltroEstadoParo" name="FiltroEstadoParo">
                <option value="">Todos los estatus...</option>
                <option value="Activo">Activos</option>
                <option value="Resuelto">Resueltos</option>
            </select>
        </div>*@

                        <!-- Fecha Inicio -->
                        <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                            <label class="filtro-label" for="FiltroFechaInicio">
                                <i class="bi bi-calendar-check-fill"></i> Fecha Inicio
                            </label>
                            <input type="date" class="filtro-input"
                                   id="FiltroFechaInicio"
                                   name="FiltroFechaInicio">
                        </div>

                        <!-- Fecha Fin -->
                        <div class="col-12 col-sm-6 col-md-3 col-xl-2">
                            <label class="filtro-label" for="FiltroFechaFin">
                                <i class="bi bi-calendar-x-fill"></i> Fecha Fin
                            </label>
                            <input type="date" class="filtro-input"
                                   id="FiltroFechaFin"
                                   name="FiltroFechaFin">
                        </div>

                        <!-- Botones -->
                        <div class="col-12 col-sm-6 col-md-3 col-xl-auto d-flex gap-2">
                            <button type="button"
                                    class="btn-filtro-aplicar"
                                    id="btnAplicarFiltros">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>

                            <button type="button"
                                    class="btn-filtro-limpiar"
                                    id="btnLimpiarFiltros">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Limpiar
                            </button>
                        </div>

                    </div>

                </div>


                <!-- 📊 TARJETAS DE ESTADÍSTICAS -->
                <!--<div class="row g-3 mb-4">-->
                <!-- Total de Paros -->
                <!--<div class="col-12 col-sm-6 col-xl-3">
