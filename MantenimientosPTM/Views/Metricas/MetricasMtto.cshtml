@{
    ViewBag.Title = "Métricas de Mantenimiento";
}

@*<link href="~/Content/MantenimientosPreventivos.css" rel="stylesheet" />*@
<link href="~/Content/Metricas.css" rel="stylesheet" />

<div class="row m-0 pt-3">
    <div class="col-12 col-xl-12 mb-4 mb-lg-0">
        <div class="card shadow-lg">
            <!-- Header Responsive -->
            <div class="card-header text-dark">
                <div class="row g-3 align-items-center">
                    <div class="col-6">
                        <h5 class="mb-0 text-color-logo">
                            <i class="bi bi-graph-up-arrow me-2"></i>Métricas de Mantenimiento
                        </h5>
                    </div>
                    <div class="col-6 d-flex justify-content-end">
                        <h6 id="fechaActual" class="text-primary"></h6><h6 class="ps-1 text-primary" id="horaActual"></h6>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <!-- Sección de Filtros -->
                <form id="formFiltrosMetricas" autocomplete="on">
                    <div class="filtros-panel">

                        <div class="filtros-titulo">
                            <i class="bi bi-sliders" style="color:#0ea5d8"></i>
                            Filtros de búsqueda
                        </div>

                        <div class="row g-2 align-items-end">

                            <!-- Fecha Inicio -->
                            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                <label class="filtro-label" for="FiltroFechaInicio">
                                    <i class="bi bi-calendar-check-fill"></i> Fecha Inicio
                                </label>
                                <input type="date" class="filtro-input"
                                       id="FiltroFechaInicio" name="FiltroFechaInicio">
                            </div>

                            <!-- Fecha Fin -->
                            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                <label class="filtro-label" for="FiltroFechaFin">
                                    <i class="bi bi-calendar-x-fill"></i> Fecha Fin
                                </label>
                                <input type="date" class="filtro-input"
                                       id="FiltroFechaFin" name="FiltroFechaFin">
                            </div>
                            <!-- Planta -->
                            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                <label class="filtro-label" for="FiltroPlanta">
                                    <i class="bi bi-building"></i> Planta
                                </label>
                                <div class="select-wrapper">
                                    <select class="filtro-input"
                                            id="FiltroPlanta" name="FiltroPlanta" disabled>
                                        <option value="">Todas las plantas...</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                    </select>
                                    <div class="select-loader d-none" id="loader_FiltroPlanta">
                                        <span class="spinner-border spinner-border-sm"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Proceso -->
                            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                <label class="filtro-label" for="FiltroProceso">
                                    <i class="bi bi-grid-fill"></i> Proceso
                                </label>
                                <div class="select-wrapper">
                                    <select class="filtro-input"
                                            id="FiltroProceso" name="FiltroProceso">
                                        <option value="">Todas las áreas...</option>
                                    </select>
                                    <div class="select-loader d-none" id="loader_FiltroProceso">
                                        <span class="spinner-border spinner-border-sm"></span>
                                    </div>
                                </div>
                            </div>
                            <!-- Línea -->
                            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                <label class="filtro-label" for="FiltroLinea">
                                    <i class="bi bi-diagram-3-fill"></i> Línea
                                </label>
                                <div class="select-wrapper">
                                    <select class="filtro-input"
                                            id="FiltroLinea" name="FiltroLinea">
                                        <option value="">Todas las líneas...</option>
                                    </select>
                                    <div class="select-loader d-none" id="loader_FiltroLinea">
                                        <span class="spinner-border spinner-border-sm"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Equipo -->
                            @*<div class="col-12 col-sm-6 col-md-4 col-xl-2">
                                    <label class="filtro-label" for="FiltroEquipo">
                                        <i class="bi bi-cpu-fill"></i> Equipo
                                    </label>
                                    <div class="select-wrapper">
                                        <select class="filtro-input"
                                                id="FiltroEquipo" name="FiltroEquipo">
                                            <option value="">Todos los equipos...</option>
                                        </select>
                                        <div class="select-loader d-none" id="loader_FiltroEquipo">
                                            <span class="spinner-border spinner-border-sm"></span>
                                        </div>
                                    </div>
                                </div>*@

                            <!-- Botones -->
                            <div class="col-12 col-sm-6 col-md-4 col-xl-auto d-flex align-items-end gap-2">
                                <button type="button"
                                        class="btn-filtro-aplicar"
                                        id="btnAplicarFiltros">
                                    <i class="bi bi-search"></i>
                                    Buscar
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- Sección de Métricas -->
                <div class="mb-4">
                    <h6 class="text-primary mb-3 pb-2 border-bottom">
                        <i class="bi bi-clipboard-data-fill me-2"></i>Indicadores de Rendimiento (KPIs)
                    </h6>

                    <div class="row g-3">
                        <!-- MTBF Card -->
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header MetricHeader text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-gear-wide-connected me-2"></i>MTBF
                                    </h6>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <p class="card-text text-muted small mb-2">
                                        Promedio de tiempo entre fallas para equipos de producción.
                                    </p>

                                    <!-- Valor central -->
                                    <div style="position:relative; height:160px; width:160px; margin:0 auto;">
                                        <canvas id="mtbfDonutChart" role="img" aria-label="Gráfica MTBF: tiempo disponible vs correctivos">MTBF</canvas>
                                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                                            <div class="fw-bold text-info fs-4" id="metric-mtbf">--</div>
                                            <small class="text-muted" style="font-size:10px;">hrs</small>
                                        </div>
                                    </div>

                                    <!-- Desglose -->
                                    <div class="mt-2" style="font-size:12px;">
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#0dcaf0;display:inline-block;border-radius:2px;margin-right:4px;"></span>T. Disponible</span>
                                            <span id="lbl-mtbf-disponible">-- hr</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#a8eaf7;display:inline-block;border-radius:2px;margin-right:4px;"></span>T. Correctivos</span>
                                            <span id="lbl-mtbf-correctivos">-- hr</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Última actualización: <span id="mtbf-update">--</span>
                                </div>
                            </div>
                        </div>


                        <!-- MTTR Card -->
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header MetricHeader MetricHeader--tiempo-respuesta text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-stopwatch-fill me-2"></i>MTTR
                                    </h6>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <p class="card-text text-muted small mb-2">
                                        Promedio de tiempo necesario para reparar un equipo.
                                    </p>

                                    <!-- Valor central -->
                                    <div style="position:relative; height:160px; width:160px; margin:0 auto;">
                                        <canvas id="mttrDonutChart" role="img" aria-label="Gráfica MTTR: correctivos vs productivo">MTTR</canvas>
                                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                                            <div class="fw-bold text-warning fs-4" id="metric-mttr">--</div>
                                            <small class="text-muted" style="font-size:10px;">hrs</small>
                                        </div>
                                    </div>

                                    <!-- Desglose -->
                                    <div class="mt-2" style="font-size:12px;">
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#eda100;display:inline-block;border-radius:2px;margin-right:4px;"></span>T. Correctivos</span>
                                            <span id="lbl-mttr-correctivos">-- hr</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#fde5a0;display:inline-block;border-radius:2px;margin-right:4px;"></span>T. Productivo</span>
                                            <span id="lbl-mttr-productivo">-- hr</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Última actualización: <span id="mttr-update">--</span>
                                </div>
                            </div>
                        </div>


                        <!-- FPY Card -->
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header MetricHeader MetricHeader--calidad text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-check-circle-fill me-2"></i>FPY
                                    </h6>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <p class="card-text text-muted small mb-2">
                                        Porcentaje de producción que pasa inspección sin retrabajo.
                                    </p>

                                    <!-- Valor central -->
                                    <div style="position:relative; height:160px; width:160px; margin:0 auto;">
                                        <canvas id="fpyDonutChart" role="img" aria-label="Gráfica FPY: producción neta vs scrap">FPY</canvas>
                                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                                            <div class="fw-bold text-success fs-4" id="metric-fpy">--</div>
                                            <small class="text-muted" style="font-size:10px;">FPY</small>
                                        </div>
                                    </div>

                                    <!-- Desglose -->
                                    <div class="mt-2" style="font-size:12px;">
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#1baf7a;display:inline-block;border-radius:2px;margin-right:4px;"></span>Producción Neta</span>
                                            <span id="lbl-fpy-neta">-- kg</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#f28b82;display:inline-block;border-radius:2px;margin-right:4px;"></span>Total Scrap</span>
                                            <span id="lbl-fpy-scrap">-- kg</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Última actualización: <span id="fpy-update">--</span>
                                </div>
                            </div>
                        </div>

                        <!-- OEE Card -->
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header MetricHeader text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-speedometer2 me-2"></i>OEE
                                    </h6>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <p class="card-text text-muted small mb-2">
                                        Eficiencia general del equipo (disponibilidad × rendimiento × calidad).
                                    </p>
                                    <div style="position:relative; height:160px; width:160px; margin:0 auto;">
                                        <canvas id="oeeDonutChart" role="img" aria-label="Gráfica OEE: disponibilidad, rendimiento y calidad">OEE</canvas>
                                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                                            <div class="fw-bold text-danger fs-4" id="metric-oee">--</div>
                                            <small class="text-muted" style="font-size:10px;">OEE</small>
                                        </div>
                                    </div>
                                    <div class="mt-2" style="font-size:12px;">
                                        <div class="d-flex justify-content-between"><span><span style="width:8px;height:8px;background:#2a78d6;display:inline-block;border-radius:2px;margin-right:4px;"></span>Disponibilidad</span><span id="lbl-disp-oee">--%</span></div>
                                        <div class="d-flex justify-content-between"><span><span style="width:8px;height:8px;background:#1baf7a;display:inline-block;border-radius:2px;margin-right:4px;"></span>Rendimiento</span><span id="lbl-rend-oee">--%</span></div>
                                        <div class="d-flex justify-content-between"><span><span style="width:8px;height:8px;background:#eda100;display:inline-block;border-radius:2px;margin-right:4px;"></span>Calidad</span><span id="lbl-cal-oee">--%</span></div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Última actualización: <span id="oee-update">--</span>
                                </div>
                            </div>
                        </div>

                        <!-- CUMPLIMIENTO MANTENIMIENTO PREVENTIVO Card -->
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header MetricHeader MetricHeader--cumplimiento text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-clock-history me-2"></i>Cumplimiento Mantenimiento Preventivo
                                    </h6>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <p class="card-text text-muted small mb-2">
                                        Porcentaje de órdenes de mantenimiento preventivo cerradas contra las programadas.
                                    </p>

                                    <!-- Valor central -->
                                    <div style="position:relative; height:160px; width:160px; margin:0 auto;">
                                        <canvas id="cumplimientoPMDonutChart" role="img" aria-label="Gráfica Cumplimiento PM">Cumplimiento PM</canvas>
                                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                                            <div class="fw-bold text-primary fs-4" id="metric-cumplimientopm">--</div>
                                            <small class="text-muted" style="font-size:10px;">Cumplimiento PM</small>
                                        </div>
                                    </div>

                                    <!-- Desglose -->
                                    <div class="mt-2" style="font-size:12px;">
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#1baf7a;display:inline-block;border-radius:2px;margin-right:4px;"></span>PM Cerrados</span>
                                            <span id="lbl-pm-cerrados">--</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#e0e0e0;display:inline-block;border-radius:2px;margin-right:4px;"></span>PM Programados</span>
                                            <span id="lbl-pm-programados">--</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Última actualización: <span id="cumplimientopm-update">--</span>
                                </div>
                            </div>
                        </div>


                        <!-- TIEMPO DE ESPERA / MTTA Card -->
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header MetricHeader MetricHeader--tiempo-respuesta text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-hourglass-split me-2"></i>MTTA
                                    </h6>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <p class="card-text text-muted small mb-2">
                                        Tiempo medio entre la generación de la orden y el inicio de reparación del técnico.
                                    </p>

                                    <div style="position:relative; height:160px; width:160px; margin:0 auto;">
                                        <canvas id="tiempoEsperaDonutChart" role="img" aria-label="Gráfica MTTA">MTTA</canvas>
                                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                                            <div class="fw-bold text-primary fs-4" id="metric-mtta">--</div>
                                            <small class="text-muted" style="font-size:10px;">hrs promedio</small>
                                        </div>
                                    </div>

                                    <div class="mt-2" style="font-size:12px;">
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#eda100;display:inline-block;border-radius:2px;margin-right:4px;"></span>ΣT.E (total)</span>
                                            <span id="lbl-tiempo-espera-total">-- hr</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span><span style="width:8px;height:8px;background:#f5d78c;display:inline-block;border-radius:2px;margin-right:4px;"></span>OTs con espera</span>
                                            <span id="lbl-tiempo-espera-total-ots">--</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Última actualización: <span id="mtta-update">--</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alerta Container -->
                    <div class="row pt-3">
                        <div class="col-md-12">
                            <div id="alertContainer"></div>
                        </div>
                    </div>
                </div>

                <!-- Información Adicional -->
                <div class="alert alert-info bg-light border-info d-flex align-items-start" role="alert">
                    <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                    <div>
                        <h6 class="fw-bold mb-1">
                            <i class="bi bi-lightbulb me-1"></i>Información
                        </h6>
                        <p class="mb-0 small">
                            Las métricas se actualizan automáticamente según los filtros aplicados.
                            Seleccione una línea y proceso específicos para obtener datos más precisos.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Container para alerts de Bootstrap -->
<div id="alertMainContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999; margin-top: 70px;">
    <!-- Los alerts se insertarán aquí dinámicamente -->
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="~/Scripts/metricas_mannto_refactor.js"></script>
