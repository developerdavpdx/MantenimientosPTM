        [HttpPost]
        public JsonResult GetReporteStock()
        {
            try
            {
                string draw = Request.Form["draw"];
                int NroPeticion = Convert.ToInt32(!string.IsNullOrEmpty(draw) ? draw : "0");

                string lenght = Request.Form["length"];
                int CantidadRegistros = Convert.ToInt32(!string.IsNullOrEmpty(lenght) ? lenght : "10");

                string start = Request.Form["start"];
                int OmitirRegistros = Convert.ToInt32(!string.IsNullOrEmpty(start) ? start : "0");

                string FiltroPlanta = Request.Form["FiltroPlanta"];
                string FiltroCodigoArticulo = Request.Form["FiltroCodigoArticulo"];
                string FiltroNombreArticulo = Request.Form["FiltroNombreArticulo"];

                string almacen = string.Empty;
                if (FiltroPlanta == "1")
                    almacen = "COR040";
                else if (FiltroPlanta == "2")
                    almacen = "P2040";
                else
                    almacen = "COR040";

                var parameters = new Dictionary<string, (object value, ParameterDirection direction, HanaDbType type)>
                {
                    { "P_WHSCODE", (almacen, ParameterDirection.Input, HanaDbType.NVarChar) },
                    { "P_ITEMCODE", (string.IsNullOrEmpty(FiltroCodigoArticulo) ? (object)null : FiltroCodigoArticulo, ParameterDirection.Input, HanaDbType.NVarChar) },
                    { "P_ITEMNAME", (string.IsNullOrEmpty(FiltroNombreArticulo) ? (object)null : FiltroNombreArticulo, ParameterDirection.Input, HanaDbType.NVarChar) }
                };

                var resultHana = Logic.GlobalCommands.ExecuteProcedureHanaAuto(
                    Logic.AD.GCConsultaStockAlmacen,
                    parameters
                );

                List<ReporteStock> datos = new List<ReporteStock>();

                if (!string.IsNullOrEmpty(resultHana.JsonResult) && resultHana.JsonResult != "[]")
                {
                    datos = JsonConvert.DeserializeObject<List<ReporteStock>>(resultHana.JsonResult);
                }

                int totalRegistros = datos.Count;
                var datosPaginados = datos.Skip(OmitirRegistros).Take(CantidadRegistros).ToList();

                var resultado = Json(new
                {
                    draw = NroPeticion,
                    recordsTotal = totalRegistros,
                    recordsFiltered = totalRegistros,
                    data = datosPaginados
                }, JsonRequestBehavior.AllowGet);

                resultado.MaxJsonLength = 2147483644;
                return resultado;
            }
            catch (Exception ex)
            {
                string MethodName = MethodBase.GetCurrentMethod().Name;
                string ControllerName = this.ControllerContext.RouteData.Values["controller"].ToString();
                string msg = $"No es posible obtener el reporte de stock en {MethodName} de {ControllerName}. Error: ";

                return Json(new
                {
                    draw = 0,
                    recordsTotal = 0,
                    recordsFiltered = 0,
                    data = new List<object>(),
                    error = msg + ex.Message
                }, JsonRequestBehavior.AllowGet);
            }
        }


