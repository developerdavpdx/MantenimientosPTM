                        To = emails,
                        Subject = $"Solicitud de Compra #{folio} - Autorización Requerida",
                        Body = htmlFinal,
                        Alias = "PTM - Sistema de Mantenimientos",
                        ImagePath = "~/Content/Images/LogoPTM.png"
