        [HttpGet]
        public JsonResult BuscarProveedor(string query, string Usuario)
        {
            try
            {
                if (string.IsNullOrEmpty(query))
                {
                    return Json(new List<object>(), JsonRequestBehavior.AllowGet);
                }

                var parameters = new Dictionary<string, (object value, ParameterDirection direction, HanaDbType type)>
                {
                    { "P_QUERY",   (query,   ParameterDirection.Input, HanaDbType.NVarChar) },
                    { "P_USUARIO", (Usuario, ParameterDirection.Input, HanaDbType.NVarChar) }
                };

                var resultHana = Logic.GlobalCommands.ExecuteProcedureHanaAuto(
                    Logic.AD.GCConsultaProveedores,
                    parameters
                );

                List<AccesoDatosAlmacen.Proveedores> proveedores = new List<AccesoDatosAlmacen.Proveedores>();
                if (!string.IsNullOrEmpty(resultHana.JsonResult) && resultHana.JsonResult != "[]")
                {
                    proveedores = JsonConvert.DeserializeObject<List<AccesoDatosAlmacen.Proveedores>>(resultHana.JsonResult);
                }

                return Json(proveedores, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                string MethodName = MethodBase.GetCurrentMethod().Name;
                string ControllerName = this.ControllerContext.RouteData.Values["controller"].ToString();
                string msg = $"Error al buscar proveedores en {MethodName} de {ControllerName}. Error: {ex.Message}";
                return Json(new List<object>(), JsonRequestBehavior.AllowGet);
            }
        }
